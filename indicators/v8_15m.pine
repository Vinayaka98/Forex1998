//@version=6
// Trading System v8, Part IV (15M execution, M0-M16) with Part VII setups, Part VIII
// management and Part X no-trade rules. An INDICATOR: it draws where to enter, the stop
// loss and the take profit, and sends the alerts ("Any alert() function call").
//
// Pipeline on a 15M chart:
//   Daily bias (same rules as v8 Daily)  ->  4H zones rebuilt at every 4H close
//   (same rules as v8 4H)  ->  price enters a zone  ->  approved trigger  ->  structure
//   shift  ->  chop / news / VWAP-SVP / room / exposure checks  ->  BUY/SELL with SL, TP, size.
// Volume profiles are kept incrementally in price buckets so a full backtest stays fast.
indicator("v8 15M Entries", shorttitle = "v8 15M", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 300, max_bars_back = 2000)

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────
const string G_R  = "Risk (non-negotiable)"
const string G_D  = "Daily bias (same rules as v8 Daily)"
const string G_4  = "4H zones (same rules as v8 4H)"
const string G_VP = "Volume profiles"
const string G_M  = "15M execution"
const string G_T  = "Trade management"
const string G_O  = "Display & alerts"

accountSize = input.float(120000, "Account size", minval = 1, group = G_R)
accountCcy  = input.string("CAD", "Account currency", group = G_R)
riskPct     = input.float(0.1, "Risk per trade %", minval = 0.01, maxval = 0.1, step = 0.01, group = G_R, tooltip = "The manual caps this at 0.1%.")
maxOpen     = input.int(3, "Max open positions (this pair)", minval = 1, maxval = 3, group = G_R)
maxOpenRisk = input.float(0.2, "Max open risk % (this pair)", minval = 0.1, maxval = 0.3, step = 0.05, group = G_R, tooltip = "Trades whose stop is not yet at break-even or better count as open risk. Correlated risk across pairs cannot be seen from one chart: check it yourself.")
spreadPips  = input.float(1.0, "Spread + commission (pips; non-FX: basis points of price)", minval = 0, step = 0.1, group = G_R, tooltip = "Added to the stop buffer and charged in the results. For BTC/stocks 1 = 0.01% of price.")
qtyStepIn   = input.float(0, "Quantity step (0 = auto)", minval = 0, group = G_R, tooltip = "Auto: forex 1,000 units (0.01 lot), crypto 0.0001, everything else 1. Position size is rounded down to this.")

dSwingLen  = input.int(5, "Daily swing strength", minval = 2, group = G_D)
dMinRevAtr = input.float(1.5, "Daily meaningful swing (× Daily ATR)", minval = 0, step = 0.1, group = G_D)
hmaSlowLen = input.int(200, "HMA slow", minval = 10, group = G_D)
hmaFastLen = input.int(55, "HMA fast", minval = 5, group = G_D)
slopeBars  = input.int(5, "HMA slope lookback (bars)", minval = 1, group = G_D)
flatAtr    = input.float(0.05, "HMA flat if slope < ATR ×", minval = 0, step = 0.01, group = G_D)
crossLook  = input.int(20, "Daily crossing window (days)", minval = 5, group = G_D)
crossMax   = input.int(2, "Daily 'crossing repeatedly' = N crosses", minval = 1, group = G_D)
atrLen     = input.int(14, "ATR length (RMA)", minval = 1, group = G_D)

swingLen4  = input.int(5, "4H swing strength", minval = 2, group = G_4)
minRevAtr4 = input.float(1.5, "4H meaningful swing (× 4H ATR)", minval = 0, step = 0.1, group = G_4)
clusterAtr = input.float(0.6, "Zone: levels within 4H ATR × form one zone", minval = 0.1, step = 0.1, group = G_4)
maxDistD   = input.float(1.5, "Only zones within Daily ATR × of price", minval = 0.2, step = 0.1, group = G_4)
invBufAtr  = input.float(0.1, "4H invalidation buffer (× 4H ATR)", minval = 0, step = 0.05, group = G_4)
gapMinPct  = input.float(30, "Gaps: min size (% of 4H ATR)", minval = 0, group = G_4)
useRound   = input.bool(true, "Round numbers (00 / 50) as category E", group = G_4)
obstacleMd = input.string("Serious obstacles", "First obstacle / target (H13, M13)", options = ["Serious obstacles", "Any single level (strict)"], group = G_4, tooltip = "Serious = the nearest cluster with 2+ evidence categories, a Daily/4H swing, or a 4H Fib extension. Strict = any single value / volume / swing / gap level, which in a crowded area rarely leaves 2R of room.")

binPips    = input.float(2.0, "Profile bucket size (pips; non-FX: basis points)", minval = 0.5, step = 0.5, group = G_VP)
vaPct      = input.float(70, "Value area %", minval = 50, maxval = 95, group = G_VP)
vpRows     = input.int(100, "Rows for HVN / LVN detection", minval = 20, maxval = 300, group = G_VP)
vrvp4hDays = input.int(28, "4H VRVP stand-in window (days)", minval = 7, group = G_VP)
vrvpDDays  = input.int(120, "Daily VRVP stand-in window (days)", minval = 30, group = G_VP)
storeDays  = input.int(200, "15M history kept for impulse profiles (days)", minval = 60, maxval = 400, group = G_VP)

swingLen15 = input.int(3, "15M swing strength (bars each side)", minval = 1, group = G_M)
armBars    = input.int(48, "Zone stays armed after first touch (15M bars)", minval = 4, group = G_M, tooltip = "48 bars = 12 hours. After that, price must leave the zone and come back.")
trigWindow = input.int(8, "Structure shift must follow the trigger within (bars)", minval = 1, group = G_M)
wickMult   = input.float(1.5, "Rejection wick ≥ body ×", minval = 0.5, step = 0.1, group = G_M)
engulfPos  = input.float(0.7, "Engulfing closes in the top/bottom (1 - x) of its range", minval = 0.5, maxval = 1, step = 0.05, group = G_M)
dtapTol    = input.float(0.25, "Double tap: 2nd test may undercut by ATR ×", minval = 0, step = 0.05, group = G_M)
brBars     = input.int(96, "Setup B: zone was broken within (bars)", minval = 4, group = G_M)
chaseAtr   = input.float(0.25, "Anti-chase: max distance from trigger level (× 15M ATR)", minval = 0.05, step = 0.05, group = G_M, tooltip = "Further than this → a LIMIT order at the retest level instead of a market order (M7 / M15).")
limitBars  = input.int(4, "Limit order valid for (bars)", minval = 1, group = G_M)
stopMode   = input.string("Sweep low/high", "Stop placement (M12)", options = ["Sweep low/high", "Beyond the zone"], group = G_M)
stopBufAtr = input.float(0.12, "Stop buffer beyond structure (× 15M ATR)", minval = 0, step = 0.01, group = G_M)
minRR      = input.float(2.0, "Min R to the first obstacle (M13)", minval = 1, step = 0.1, group = G_M)
volMult    = input.float(1.2, "Volume confirmation: ≥ MA20 ×", minval = 0.5, step = 0.1, group = G_M)
requireVol = input.bool(false, "Require volume confirmation", group = G_M, tooltip = "Off = recorded as a flag only (the manual says 'prefer'). FX volume is tick volume.")
chopNeed   = input.int(3, "Chop = at least N of 5 chop signs", minval = 1, maxval = 5, group = G_M)
newsTimes  = input.string("", "Major news today (NY time, e.g. 08:30,10:00)", group = G_M, tooltip = "Pine cannot read a calendar. Times apply to every day on the chart, including history.")
newsBuf    = input.int(15, "No entries within ± minutes of news", minval = 0, group = G_M)
useWin     = input.bool(false, "Restrict entries to a time window", group = G_M, tooltip = "Not part of v8. Off by default.")
sessWin    = input.session("0300-1600", "Entry window (NY time)", group = G_M)

exitMode   = input.string("Full planned target (T4)", "Exit protocol", options = ["Full planned target (T4)", "Trail 15M structure after 1.5R (T3)"], group = G_T, tooltip = "T4: stop or full target, nothing else (the manual's base protocol for clean statistics). T3: after +1.5R the stop follows newly confirmed 15M swings.")

showZones  = input.bool(true, "Draw zones", group = G_O)
showBlock  = input.bool(true, "Mark skipped setups (hover for reason)", group = G_O)
showTable  = input.bool(true, "15M table", group = G_O)
alertArm   = input.bool(false, "Alert: price entered a zone", group = G_O)

const string TZ = "America/New_York"
const int    DAY = 86400000

// ─────────────────────────────────────────────────────────────────────────────
// Shared helpers (identical to v8 Daily / v8 4H)
// ─────────────────────────────────────────────────────────────────────────────
// "pip": forex = the usual pip; anything else (BTC, stocks, indices) = 1 basis point (0.01%) of the
// first price on the chart, so every pip-based setting scales with the instrument.
bool  isFx = syminfo.type == "forex"
var float bpUnit = na
if na(bpUnit)
    bpUnit := close * 0.0001
float pip = isFx ? syminfo.mintick * (syminfo.pricescale == 100000 or syminfo.pricescale == 1000 ? 10 : 1) : bpUnit
float binSz = binPips * pip
float atr15 = ta.atr(atrLen)
f_px(float p) => na(p) ? "n/a" : str.tostring(p, format.mintick)

f_swing(array<float> p, array<int> t, array<bool> h, float price, int tm, bool hi, float minMove) =>
    int n = p.size()
    if n == 0
        p.push(price)
        t.push(tm)
        h.push(hi)
    else if h.last() == hi
        if hi ? price > p.last() : price < p.last()
            p.set(n - 1, price)
            t.set(n - 1, tm)
    else if math.abs(price - p.last()) >= minMove
        p.push(price)
        t.push(tm)
        h.push(hi)
    p.size()

f_lastTwo(array<float> p, array<bool> h, bool hi) =>
    float a = na
    float b = na
    int n = p.size()
    if n > 0
        for i = n - 1 to 0
            if h.get(i) == hi
                if na(a)
                    a := p.get(i)
                else
                    b := p.get(i)
                    break
    [a, b]

f_impulse(array<float> p, array<int> t, array<bool> h, int pref) =>
    float sp = na
    float ep = na
    int   st = na
    int   et = na
    int   dir = 0
    int n = p.size()
    if n >= 3
        for i = n - 1 to 2
            int d = h.get(i) ? 1 : -1
            if pref == 0 or pref == d
                bool broke = d == 1 ? p.get(i) > p.get(i - 2) : p.get(i) < p.get(i - 2)
                if broke
                    sp  := p.get(i - 1)
                    st  := t.get(i - 1)
                    ep  := p.get(i)
                    et  := t.get(i)
                    dir := d
                    break
    if dir == 0 and n >= 2
        for i = n - 1 to 1
            int d = h.get(i) ? 1 : -1
            if pref == 0 or pref == d
                sp  := p.get(i - 1)
                st  := t.get(i - 1)
                ep  := p.get(i)
                et  := t.get(i)
                dir := d
                break
    [sp, st, ep, et, dir]

// ─────────────────────────────────────────────────────────────────────────────
// Daily bias (completed days only)
// ─────────────────────────────────────────────────────────────────────────────
f_daily() =>
    float atrD = ta.atr(atrLen)
    float hSd  = ta.hma(close, hmaSlowLen)
    float sSl  = hSd - hSd[slopeBars]
    int   sDd  = sSl > flatAtr * atrD ? 1 : sSl < -flatAtr * atrD ? -1 : 0
    int   crN  = int(math.sum(ta.cross(close, hSd) ? 1 : 0, crossLook))
    int   sdD  = close > hSd ? 1 : close < hSd ? -1 : 0
    var array<float> dp = array.new<float>()
    var array<int>   dt = array.new<int>()
    var array<bool>  dh = array.new<bool>()
    float phD = ta.pivothigh(high, dSwingLen, dSwingLen)
    float plD = ta.pivotlow(low, dSwingLen, dSwingLen)
    float mm  = dMinRevAtr * nz(atrD[dSwingLen], nz(atrD))
    if not na(plD)
        f_swing(dp, dt, dh, plD, time[dSwingLen], false, mm)
    if not na(phD)
        f_swing(dp, dt, dh, phD, time[dSwingLen], true, mm)
    while dp.size() > 60
        dp.shift()
        dt.shift()
        dh.shift()
    [lH, pH] = f_lastTwo(dp, dh, true)
    [lL, pL] = f_lastTwo(dp, dh, false)
    int stD = 0
    if not na(pH) and not na(pL)
        bool hh = lH > pH
        bool hl = lL > pL
        stD := hh and hl ? 1 : not hh and not hl ? -1 : 0
        if stD == 1 and close < lL
            stD := 0
        if stD == -1 and close > lH
            stD := 0
    int b = stD == 1 and sdD == 1 and sDd == 1 and crN < crossMax ? 1 : stD == -1 and sdD == -1 and sDd == -1 and crN < crossMax ? -1 : 0
    [isp, ist, iep, iet, idir] = f_impulse(dp, dt, dh, b)
    [b[1], stD[1], sdD[1], sDd[1], crN[1], lH[1], pH[1], lL[1], pL[1], isp[1], ist[1], iep[1], iet[1], idir[1], atrD[1]]

[dBias, dStruct, dSide, dSlope, dCross, dLH, dPH, dLL, dPL, dIsp, dIst, dIep, dIet, dIdir, dAtr] = request.security(syminfo.tickerid, "D", f_daily(), lookahead = barmerge.lookahead_on)
string dBiasTxt = dBias == 1 ? "LONG" : dBias == -1 ? "SHORT" : "NEUTRAL"

// ─────────────────────────────────────────────────────────────────────────────
// 4H context (completed 4H candles only)
// ─────────────────────────────────────────────────────────────────────────────
f_h4() =>
    float a4   = ta.atr(atrLen)
    float s    = ta.hma(close, hmaSlowLen)
    float f    = ta.hma(close, hmaFastLen)
    int   sDir = s - s[slopeBars] > flatAtr * a4 ? 1 : s - s[slopeBars] < -flatAtr * a4 ? -1 : 0
    int   fDir = f - f[slopeBars] > flatAtr * a4 ? 1 : f - f[slopeBars] < -flatAtr * a4 ? -1 : 0
    int   sd   = close > s ? 1 : -1
    var array<float> p = array.new<float>()
    var array<int>   t = array.new<int>()
    var array<bool>  h = array.new<bool>()
    float ph = ta.pivothigh(high, swingLen4, swingLen4)
    float pl = ta.pivotlow(low, swingLen4, swingLen4)
    float mm = minRevAtr4 * nz(a4[swingLen4], nz(a4))
    if not na(pl)
        f_swing(p, t, h, pl, time[swingLen4], false, mm)
    if not na(ph)
        f_swing(p, t, h, ph, time[swingLen4], true, mm)
    while p.size() > 60
        p.shift()
        t.shift()
        h.shift()
    [qLH, qPH] = f_lastTwo(p, h, true)
    [qLL, qPL] = f_lastTwo(p, h, false)
    [uSp, uSt, uEp, uEt, uDir] = f_impulse(p, t, h, 1)
    [wSp, wSt, wEp, wEt, wDir] = f_impulse(p, t, h, -1)
    var array<float> gT = array.new<float>()
    var array<float> gB = array.new<float>()
    int gn = gT.size()
    if gn > 0
        for i = gn - 1 to 0
            if low <= gB.get(i) and high >= gT.get(i)
                gT.remove(i)
                gB.remove(i)
    float gMin = gapMinPct / 100 * nz(a4[1])
    if low > high[1] and low - high[1] >= gMin
        gT.push(low)
        gB.push(high[1])
    else if high < low[1] and low[1] - high >= gMin
        gT.push(low[1])
        gB.push(high)
    while gT.size() > 15
        gT.shift()
        gB.shift()
    float upB = na
    float upT = na
    float dnB = na
    float dnT = na
    int gc = gT.size()
    if gc > 0
        for i = 0 to gc - 1
            if gB.get(i) > close and (na(upB) or gB.get(i) < upB)
                upB := gB.get(i)
                upT := gT.get(i)
            if gT.get(i) < close and (na(dnT) or gT.get(i) > dnT)
                dnB := gB.get(i)
                dnT := gT.get(i)
    [a4[1], sDir[1], fDir[1], sd[1], qLH[1], qPH[1], qLL[1], qPL[1], uSp[1], uSt[1], uEp[1], uEt[1], wSp[1], wSt[1], wEp[1], wEt[1], upB[1], upT[1], dnB[1], dnT[1], time]

[h4Atr, h4SDir, h4FDir, h4Side, h4LH, h4PH, h4LL, h4PL, h4USp, h4USt, h4UEp, h4UEt, h4DSp, h4DSt, h4DEp, h4DEt, g4UpB, g4UpT, g4DnB, g4DnT, h4Time] = request.security(syminfo.tickerid, "240", f_h4(), lookahead = barmerge.lookahead_on)
bool h4New = h4Time != h4Time[1]

// ─────────────────────────────────────────────────────────────────────────────
// Incremental volume profiles in fixed price buckets
// ─────────────────────────────────────────────────────────────────────────────
f_mapAdd(map<int, float> m, float h, float l, float v, float sign) =>
    int a = math.floor(l / binSz)
    int b = math.floor(h / binSz)
    float share = sign * v / (b - a + 1)
    for k = a to b
        float nv = nz(m.get(k)) + share
        if sign < 0 and nv <= 1e-9
            m.remove(k)
        else
            m.put(k, nv)
    b - a

f_va(map<int, float> m) =>
    float poc = na
    float vah = na
    float val = na
    array<int> ks = m.keys()
    int n = ks.size()
    if n > 0
        ks.sort(order.ascending)
        array<float> vs = array.new<float>(n, 0.0)
        for i = 0 to n - 1
            vs.set(i, math.max(0.0, nz(m.get(ks.get(i)))))
        float tot = vs.sum()
        if tot > 0
            int   pr   = vs.indexof(vs.max())
            float goal = tot * vaPct / 100
            float acc  = vs.get(pr)
            int up = pr
            int dn = pr
            while acc < goal and (up < n - 1 or dn > 0)
                float nu = up < n - 1 ? vs.get(up + 1) : -1.0
                float nd = dn > 0 ? vs.get(dn - 1) : -1.0
                if nu >= nd
                    up  += 1
                    acc += nu
                else
                    dn  -= 1
                    acc += nd
            poc := (ks.get(pr) + 0.5) * binSz
            vah := (ks.get(up) + 1) * binSz
            val := ks.get(dn) * binSz
    [poc, vah, val]

// Resample a bucket map into vpRows rows, then find the nearest major HVN / LVN above and below price
f_nodes(map<int, float> m, float price) =>
    float hvnUp = na
    float hvnDn = na
    float lvnUp = na
    float lvnDn = na
    array<int> ks = m.keys()
    int nk = ks.size()
    if nk > 8
        int   kmin = ks.min()
        int   kmax = ks.max()
        float bot  = kmin * binSz
        float step = (kmax + 1 - kmin) * binSz / vpRows
        array<float> rows = array.new<float>(vpRows, 0.0)
        for i = 0 to nk - 1
            int k = ks.get(i)
            int r = math.max(0, math.min(vpRows - 1, math.floor((k - kmin) * binSz / step)))
            rows.set(r, rows.get(r) + math.max(0.0, nz(m.get(k))))
        array<float> sm = array.new<float>(vpRows, 0.0)
        for i = 0 to vpRows - 1
            float s = 0.0
            int c = 0
            for j = math.max(0, i - 2) to math.min(vpRows - 1, i + 2)
                s += rows.get(j)
                c += 1
            sm.set(i, s / c)
        float mean = sm.avg()
        for i = 3 to vpRows - 4
            float v = sm.get(i)
            bool isMax = true
            bool isMin = true
            for j = i - 3 to i + 3
                if j != i
                    if sm.get(j) > v
                        isMax := false
                    if sm.get(j) < v
                        isMin := false
            float px = bot + (i + 0.5) * step
            if isMax and v >= 1.2 * mean
                if px > price and (na(hvnUp) or px < hvnUp)
                    hvnUp := px
                if px < price and (na(hvnDn) or px > hvnDn)
                    hvnDn := px
            if isMin and v <= 0.6 * mean
                if px > price and (na(lvnUp) or px < lvnUp)
                    lvnUp := px
                if px < price and (na(lvnDn) or px > lvnDn)
                    lvnDn := px
    [hvnUp, hvnDn, lvnUp, lvnDn]

var map<int, float> mpSes = map.new<int, float>()
var map<int, float> mpW   = map.new<int, float>()
var map<int, float> mpPW  = map.new<int, float>()
var map<int, float> mpM   = map.new<int, float>()
var map<int, float> mpPM  = map.new<int, float>()
var map<int, float> mpVD  = map.new<int, float>()
var map<int, float> mpV4  = map.new<int, float>()
var array<float> bH = array.new<float>()
var array<float> bL = array.new<float>()
var array<float> bV = array.new<float>()
var array<int>   bT = array.new<int>()
var int base = 0
var int ptrD = 0
var int ptr4 = 0
var float sesPocV = 0.0
var int   sesPocK = na
var float pwPoc = na
var float pwVah = na
var float pwVal = na
var float pmPoc = na
var float pmVah = na
var float pmVal = na

float vol = na(volume) or volume <= 0 ? 1.0 : volume
if timeframe.change("D")
    mpSes.clear()
    sesPocV := 0.0
    sesPocK := na
if timeframe.change("W")
    mpPW := mpW.copy()
    mpW.clear()
    [a1, a2, a3] = f_va(mpPW)
    pwPoc := a1
    pwVah := a2
    pwVal := a3
if timeframe.change("M")
    mpPM := mpM.copy()
    mpM.clear()
    [a1, a2, a3] = f_va(mpPM)
    pmPoc := a1
    pmVah := a2
    pmVal := a3
f_mapAdd(mpSes, high, low, vol, 1.0)
f_mapAdd(mpW, high, low, vol, 1.0)
f_mapAdd(mpM, high, low, vol, 1.0)
f_mapAdd(mpVD, high, low, vol, 1.0)
f_mapAdd(mpV4, high, low, vol, 1.0)
for k = math.floor(low / binSz) to math.floor(high / binSz)
    float sv = nz(mpSes.get(k))
    if sv > sesPocV
        sesPocV := sv
        sesPocK := k
float sesPoc = na(sesPocK) ? na : (sesPocK + 0.5) * binSz
bH.push(high)
bL.push(low)
bV.push(vol)
bT.push(time)
while ptrD - base < bT.size() and bT.get(ptrD - base) < time - vrvpDDays * DAY
    int i = ptrD - base
    f_mapAdd(mpVD, bH.get(i), bL.get(i), bV.get(i), -1.0)
    ptrD += 1
while ptr4 - base < bT.size() and bT.get(ptr4 - base) < time - vrvp4hDays * DAY
    int i = ptr4 - base
    f_mapAdd(mpV4, bH.get(i), bL.get(i), bV.get(i), -1.0)
    ptr4 += 1
while bT.size() > 0 and bT.first() < time - math.max(storeDays, vrvpDDays + 5) * DAY and base < ptrD and base < ptr4
    bH.shift()
    bL.shift()
    bV.shift()
    bT.shift()
    base += 1

// Value area of the stored 15M bars with t0 <= time < t1 (impulse Fixed VP)
f_rangeVA(int t0, int t1) =>
    map<int, float> tmp = map.new<int, float>()
    int n = bT.size()
    if n > 0 and not na(t0) and not na(t1)
        for i = 0 to n - 1
            int tt = bT.get(i)
            if tt >= t0 and tt < t1
                f_mapAdd(tmp, bH.get(i), bL.get(i), bV.get(i), 1.0)
    [p, h, l] = f_va(tmp)
    [p, h, l]

// ─────────────────────────────────────────────────────────────────────────────
// 15M context: swings, VWAP, chop signs, news, window
// ─────────────────────────────────────────────────────────────────────────────
float ph15 = ta.pivothigh(high, swingLen15, swingLen15)
float pl15 = ta.pivotlow(low, swingLen15, swingLen15)
var float sh1 = na
var float sh2 = na
var float sl1 = na
var float sl2 = na
var int   shBar = na
var int   slBar = na
if not na(ph15)
    sh2   := sh1
    sh1   := ph15
    shBar := bar_index - swingLen15
if not na(pl15)
    sl2   := sl1
    sl1   := pl15
    slBar := bar_index - swingLen15

float vw     = ta.vwap(hlc3)
float vwSl   = vw - vw[8]
int   vwDir  = vwSl > 0.1 * atr15 ? 1 : vwSl < -0.1 * atr15 ? -1 : 0
float hF15   = ta.hma(close, hmaFastLen)
int   hfDir  = hF15 - hF15[3] > 0.05 * atr15 ? 1 : hF15 - hF15[3] < -0.05 * atr15 ? -1 : 0
float volMA  = ta.sma(vol, 20)

// M2 chop: five signs, chop when at least chopNeed are present
f_chop() =>
    int flips = 0
    int twoWick = 0
    int vwX = 0
    int pocX = 0
    for j = 0 to 5
        float rng = high[j] - low[j]
        if rng > 0 and high[j] - math.max(open[j], close[j]) >= 0.3 * rng and math.min(open[j], close[j]) - low[j] >= 0.3 * rng
            twoWick += 1
        if j < 5 and (close[j] > open[j]) != (close[j + 1] > open[j + 1])
            flips += 1
    for j = 0 to 11
        if (close[j] - vw[j]) * (close[j + 1] - vw[j + 1]) < 0
            vwX += 1
        if not na(sesPoc[j]) and (close[j] - sesPoc[j]) * (close[j + 1] - sesPoc[j + 1]) < 0
            pocX += 1
    int score = (flips >= 4 ? 1 : 0) + (twoWick >= 3 ? 1 : 0) + (vwDir == 0 and vwX >= 3 ? 1 : 0) + (hfDir == 0 ? 1 : 0) + (pocX >= 3 ? 1 : 0)
    [score, flips, twoWick, vwX, pocX]
[chopScore, cFlips, cWicks, cVwX, cPocX] = f_chop()
bool chop = chopScore >= chopNeed

var array<int> newsMin = array.new<int>()
if barstate.isfirst
    string cleaned = str.replace_all(newsTimes, " ", "")
    if str.length(cleaned) > 0
        for part in str.split(cleaned, ",")
            array<string> hm = str.split(part, ":")
            if hm.size() == 2
                float hh = str.tonumber(hm.get(0))
                float mm = str.tonumber(hm.get(1))
                if not na(hh) and not na(mm)
                    newsMin.push(int(hh * 60 + mm))
int  barEndMin = hour(time_close, TZ) * 60 + minute(time_close, TZ)
bool newsBlock = false
for nm in newsMin
    if math.abs(barEndMin - nm) <= newsBuf
        newsBlock := true
bool inWin = not useWin or not na(time(timeframe.period, sessWin, TZ))

float qRate   = request.currency_rate(syminfo.currency, accountCcy, true)
float riskAmt = accountSize * riskPct / 100

// ─────────────────────────────────────────────────────────────────────────────
// 4H zones, rebuilt at every 4H close and whenever the Daily bias changes
// ─────────────────────────────────────────────────────────────────────────────
type Zone
    float  lo
    float  hi
    float  inv
    string cats
    string names
    bool   armed     = false
    bool   needLeave = false
    int    armBar    = na
    float  sweep     = na
    bool   trig      = false
    int    trigBar   = na
    string trigName  = ""
    string setup     = "A"
    float  tap1      = na
    float  tap2      = na
    string status    = "waiting for price"

var array<Zone>   zones = array.new<Zone>()
var array<float>  tgP   = array.new<float>()
var array<string> tgN   = array.new<string>()
var int minCats = 2

var float dvHvU = na
var float dvHvD = na
var float dvLvU = na
var float dvLvD = na
var float mPoc = na
var float mVah = na
var float mVal = na
var int   cDs = na
var int   cDe = na
var int   c4s = na
var int   c4e = na
var float dfPoc = na
var float dfVah = na
var float dfVal = na
var float hfPoc = na
var float hfVah = na
var float hfVal = na
var int nPlans = 0
var int nBiasPlans = 0
var int nZonePlans = 0

f_add(array<float> p, array<string> c, array<string> n, float v, string cat, string name) =>
    if not na(v)
        p.push(v)
        c.push(cat)
        n.push(name)

// Daily-level profile reads change slowly: refresh once per day
if timeframe.change("D") or barstate.isfirst
    [a1, a2, a3] = f_va(mpM)
    mPoc := a1
    mVah := a2
    mVal := a3
    [n1, n2, n3, n4] = f_nodes(mpVD, close)
    dvHvU := n1
    dvHvD := n2
    dvLvU := n3
    dvLvD := n4

bool replan = barstate.isconfirmed and (h4New or dBias != dBias[1])
if replan
    nPlans += 1
    float price = close
    float a4    = h4Atr
    int   bias  = dBias
    minCats := bias != 0 and h4Side == bias and h4SDir == bias ? 2 : 3
    // Impulse Fixed VPs, recomputed only when the impulse changes
    if dIst != cDs or dIet != cDe
        cDs := dIst
        cDe := dIet
        [a1, a2, a3] = f_rangeVA(dIst, na(dIet) ? na : dIet + DAY)
        dfPoc := a1
        dfVah := a2
        dfVal := a3
    float iSp = bias == 1 ? h4USp : h4DSp
    int   iSt = bias == 1 ? h4USt : h4DSt
    float iEp = bias == 1 ? h4UEp : h4DEp
    int   iEt = bias == 1 ? h4UEt : h4DEt
    if iSt != c4s or iEt != c4e
        c4s := iSt
        c4e := iEt
        [a1, a2, a3] = f_rangeVA(iSt, na(iEt) ? na : iEt + 4 * 3600000)
        hfPoc := a1
        hfVah := a2
        hfVal := a3
    [wPoc, wVah, wVal] = f_va(mpW)
    [hvU, hvD, lvU, lvD] = f_nodes(mpV4, price)

    array<float>  lvP = array.new<float>()
    array<string> lvC = array.new<string>()
    array<string> lvN = array.new<string>()
    f_add(lvP, lvC, lvN, mVah, "A", "mVAH")
    f_add(lvP, lvC, lvN, mPoc, "A", "mPOC")
    f_add(lvP, lvC, lvN, mVal, "A", "mVAL")
    f_add(lvP, lvC, lvN, pmVah, "A", "prev mVAH")
    f_add(lvP, lvC, lvN, pmPoc, "A", "prev mPOC")
    f_add(lvP, lvC, lvN, pmVal, "A", "prev mVAL")
    f_add(lvP, lvC, lvN, wVah, "A", "wVAH")
    f_add(lvP, lvC, lvN, wPoc, "A", "wPOC")
    f_add(lvP, lvC, lvN, wVal, "A", "wVAL")
    f_add(lvP, lvC, lvN, pwVah, "A", "prev wVAH")
    f_add(lvP, lvC, lvN, pwPoc, "A", "prev wPOC")
    f_add(lvP, lvC, lvN, pwVal, "A", "prev wVAL")
    f_add(lvP, lvC, lvN, dLH, "B", "Daily swing high")
    f_add(lvP, lvC, lvN, dPH, "B", "Daily swing high")
    f_add(lvP, lvC, lvN, dLL, "B", "Daily swing low")
    f_add(lvP, lvC, lvN, dPL, "B", "Daily swing low")
    f_add(lvP, lvC, lvN, h4LH, "B", "4H swing high")
    f_add(lvP, lvC, lvN, h4PH, "B", "4H swing high")
    f_add(lvP, lvC, lvN, h4LL, "B", "4H swing low")
    f_add(lvP, lvC, lvN, h4PL, "B", "4H swing low")
    f_add(lvP, lvC, lvN, dfPoc, "C", "Daily Fixed VP POC")
    f_add(lvP, lvC, lvN, dfVah, "C", "Daily Fixed VP VAH")
    f_add(lvP, lvC, lvN, dfVal, "C", "Daily Fixed VP VAL")
    f_add(lvP, lvC, lvN, dvHvU, "C", "Daily HVN")
    f_add(lvP, lvC, lvN, dvHvD, "C", "Daily HVN")
    f_add(lvP, lvC, lvN, dvLvU, "C", "Daily LVN")
    f_add(lvP, lvC, lvN, dvLvD, "C", "Daily LVN")
    f_add(lvP, lvC, lvN, hfPoc, "C", "4H Fixed VP POC")
    f_add(lvP, lvC, lvN, hfVah, "C", "4H Fixed VP VAH")
    f_add(lvP, lvC, lvN, hfVal, "C", "4H Fixed VP VAL")
    f_add(lvP, lvC, lvN, hvU, "C", "4H HVN")
    f_add(lvP, lvC, lvN, hvD, "C", "4H HVN")
    f_add(lvP, lvC, lvN, lvU, "C", "4H LVN")
    f_add(lvP, lvC, lvN, lvD, "C", "4H LVN")
    float dfr = dIep - dIsp
    if not na(dfr)
        f_add(lvP, lvC, lvN, dIep - 0.382 * dfr, "D", "Daily Fib 38.2")
        f_add(lvP, lvC, lvN, dIep - 0.5 * dfr, "D", "Daily Fib 50")
        f_add(lvP, lvC, lvN, dIep - 0.618 * dfr, "D", "Daily Fib 61.8")
        f_add(lvP, lvC, lvN, dIep - 0.786 * dfr, "D", "Daily Fib 78.6")
    float fr4 = iEp - iSp
    if not na(fr4)
        f_add(lvP, lvC, lvN, iEp - 0.382 * fr4, "D", "4H Fib 38.2")
        f_add(lvP, lvC, lvN, iEp - 0.5 * fr4, "D", "4H Fib 50")
        f_add(lvP, lvC, lvN, iEp - 0.618 * fr4, "D", "4H Fib 61.8")
        f_add(lvP, lvC, lvN, iEp - 0.786 * fr4, "D", "4H Fib 78.6")
    f_add(lvP, lvC, lvN, g4UpB, "E", "gap edge")
    f_add(lvP, lvC, lvN, g4UpT, "E", "gap edge")
    f_add(lvP, lvC, lvN, g4DnB, "E", "gap edge")
    f_add(lvP, lvC, lvN, g4DnT, "E", "gap edge")
    if useRound
        float rStep = isFx ? 50 * pip : math.pow(10, math.floor(math.log10(price)) - 1)
        float rBase = math.floor(price / rStep) * rStep
        for k = -4 to 5
            float rv = rBase + k * rStep
            f_add(lvP, lvC, lvN, rv, "E", not isFx ? "round number" : math.abs(rv / (100 * pip) - math.round(rv / (100 * pip))) < 0.01 ? "round 00" : "round 50")

    int lc = lvP.size()
    // Cluster into zones
    array<float>  zLo  = array.new<float>()
    array<float>  zHi  = array.new<float>()
    array<string> zCat = array.new<string>()
    array<string> zNm  = array.new<string>()
    if lc > 0
        array<int> idx = lvP.sort_indices(order.ascending)
        float rad = clusterAtr * a4
        for k = 0 to lc - 1
            int    i  = idx.get(k)
            float  v  = lvP.get(i)
            string ct = lvC.get(i)
            string nm = lvN.get(i)
            if zLo.size() == 0 or v - zLo.last() > rad
                zLo.push(v)
                zHi.push(v)
                zCat.push(ct)
                zNm.push(nm)
            else
                int z = zLo.size() - 1
                zHi.set(z, v)
                if not str.contains(zCat.get(z), ct)
                    zCat.set(z, zCat.get(z) + ct)
                if not str.contains(zNm.get(z), nm)
                    zNm.set(z, zNm.get(z) + " + " + nm)

    // Targets / first obstacles. Fib retracements and round numbers are never targets.
    tgP.clear()
    tgN.clear()
    if obstacleMd == "Any single level (strict)" and lc > 0
        for i = 0 to lc - 1
            if lvC.get(i) != "D" and not str.startswith(lvN.get(i), "round")
                tgP.push(lvP.get(i))
                tgN.push(lvN.get(i))
    else if obstacleMd != "Any single level (strict)"
        if lc > 0
            for i = 0 to lc - 1
                if lvC.get(i) == "B"
                    tgP.push(lvP.get(i))
                    tgN.push(lvN.get(i))
        int zcT = zLo.size()
        if zcT > 0
            for z = 0 to zcT - 1
                if str.length(zCat.get(z)) >= 2
                    tgP.push(zLo.get(z))
                    tgN.push("cluster [" + zCat.get(z) + "] " + zNm.get(z))
                    tgP.push(zHi.get(z))
                    tgN.push("cluster [" + zCat.get(z) + "] " + zNm.get(z))
    if not na(fr4)
        tgP.push(iSp + 1.272 * fr4)
        tgN.push("4H Fib ext 1.272")
        tgP.push(iSp + 1.618 * fr4)
        tgN.push("4H Fib ext 1.618")

    // Pick Zone 1 / Zone 2 (same rules as v8 4H)
    array<int> picks = array.new<int>()
    int zc = zLo.size()
    if bias != 0 and zc > 0
        for ps = 0 to 1
            int best = na
            for z = 0 to zc - 1
                string cats = zCat.get(z)
                int    nc   = str.length(cats)
                bool   core = str.contains(cats, "A") or str.contains(cats, "B") or str.contains(cats, "C")
                float  mid  = (zLo.get(z) + zHi.get(z)) / 2
                bool   sideOk = bias == 1 ? zLo.get(z) <= price : zHi.get(z) >= price
                bool   near   = math.abs(mid - price) <= maxDistD * dAtr
                bool   apart  = true
                if picks.size() > 0
                    int p0 = picks.get(0)
                    apart := z != p0 and (zLo.get(z) > zHi.get(p0) + 0.5 * a4 or zHi.get(z) < zLo.get(p0) - 0.5 * a4)
                if nc >= minCats and core and sideOk and near and apart
                    if na(best)
                        best := z
                    else
                        int   nb = str.length(zCat.get(best))
                        float mb = (zLo.get(best) + zHi.get(best)) / 2
                        if nc > nb or (nc == nb and math.abs(mid - price) < math.abs(mb - price))
                            best := z
            if not na(best)
                picks.push(best)

    // Keep the execution state of a zone that survives the replan (same place, ±0.25 4H ATR)
    array<Zone> fresh = array.new<Zone>()
    for pk in picks
        float lo = zLo.get(pk)
        float hi = zHi.get(pk)
        float inv = bias == 1 ? lo : hi
        for sw in array.from(h4LL, h4PL, h4LH, h4PH)
            if not na(sw)
                if bias == 1 and sw < lo and sw >= lo - a4 and sw < inv
                    inv := sw
                if bias == -1 and sw > hi and sw <= hi + a4 and sw > inv
                    inv := sw
        inv := inv - bias * invBufAtr * a4
        Zone nz0 = Zone.new(lo, hi, inv, zCat.get(pk), zNm.get(pk))
        for old in zones
            if math.abs(old.lo - lo) <= 0.25 * a4 and math.abs(old.hi - hi) <= 0.25 * a4
                nz0 := old
                nz0.lo    := lo
                nz0.hi    := hi
                nz0.inv   := inv
                nz0.cats  := zCat.get(pk)
                nz0.names := zNm.get(pk)
        fresh.push(nz0)
    zones := fresh
    nBiasPlans += bias != 0 ? 1 : 0
    nZonePlans += zones.size() > 0 ? 1 : 0

    if showZones
        int k = 0
        for z in zones
            color zc0 = bias == 1 ? color.teal : color.maroon
            box.new(bar_index, z.hi, bar_index + 16, z.lo, border_color = color.new(zc0, k == 0 ? 20 : 60), bgcolor = color.new(zc0, k == 0 ? 82 : 92), text = k == 0 ? "Z1 [" + z.cats + "]" : "Z2 [" + z.cats + "]", text_size = size.tiny, text_color = color.new(zc0, 30), text_halign = text.align_left, text_valign = text.align_top)
            k += 1

// ─────────────────────────────────────────────────────────────────────────────
// Open trades (model of what the broker holds) and management (Part VIII)
// ─────────────────────────────────────────────────────────────────────────────
type Trade
    string id
    int    dir
    int    bar
    float  entry
    float  stop
    float  tp
    float  risk
    bool   filled
    bool   limitOrder
    line   lE
    line   lS
    line   lT

var array<Trade> trades = array.new<Trade>()
var int   nClosed = 0
var int   nWins   = 0
var float sumR    = 0.0
var int nArms = 0
var int nTrig = 0
var int nConf = 0
var int nEntry = 0
var int nLimitPlaced = 0
var map<string, int> skips = map.new<string, int>()
var string lastScript = ""

// Limit fills, expiries, stop / target hits (stop assumed first if a candle hits both)
f_close(Trade t) =>
    line.set_x2(t.lE, bar_index)
    line.set_x2(t.lS, bar_index)
    line.set_x2(t.lT, bar_index)
    line.set_extend(t.lE, extend.none)
    line.set_extend(t.lS, extend.none)
    line.set_extend(t.lT, extend.none)
    true

if barstate.isconfirmed and trades.size() > 0
    for i = trades.size() - 1 to 0
        Trade t = trades.get(i)
        string side = t.dir == 1 ? "BUY" : "SELL"
        if not t.filled and bar_index > t.bar
            if t.dir == 1 ? low <= t.entry : high >= t.entry
                t.filled := true
                alert("[15M] " + syminfo.ticker + " " + side + " LIMIT filled @ " + f_px(t.entry) + " · SL " + f_px(t.stop) + " · TP " + f_px(t.tp), alert.freq_once_per_bar_close)
            else if bar_index - t.bar >= limitBars
                f_close(t)
                label.new(bar_index, t.entry, "limit expired", style = label.style_label_left, color = color.new(color.gray, 70), textcolor = color.white, size = size.tiny)
                alert("[15M] " + syminfo.ticker + " " + side + " LIMIT @ " + f_px(t.entry) + " expired unfilled: cancel the order", alert.freq_once_per_bar_close)
                trades.remove(i)
                continue
        if t.filled and bar_index > t.bar
            bool  stopHit = t.dir == 1 ? low <= t.stop : high >= t.stop
            bool  tpHit   = t.dir == 1 ? high >= t.tp : low <= t.tp
            float exitPx  = stopHit ? t.stop : tpHit ? t.tp : na
            if not na(exitPx)
                float r = t.dir * (exitPx - t.entry) / t.risk - spreadPips * pip / t.risk
                nClosed += 1
                nWins   += r > 0 ? 1 : 0
                sumR    += r
                f_close(t)
                label.new(bar_index, exitPx, (stopHit ? "SL " : "TP ") + str.tostring(r, "#.##") + "R", style = label.style_label_left, color = color.new(r > 0 ? color.green : color.red, 60), textcolor = color.white, size = size.tiny)
                alert("[15M] " + syminfo.ticker + " " + side + " closed at " + (stopHit ? "STOP " : "TARGET ") + f_px(exitPx) + " · result " + str.tostring(r, "#.##") + "R (after costs)", alert.freq_once_per_bar_close)
                trades.remove(i)
            else if exitMode == "Trail 15M structure after 1.5R (T3)"
                float fav = t.dir == 1 ? high - t.entry : t.entry - low
                if fav >= 1.5 * t.risk
                    float cand = t.dir == 1 ? (slBar > t.bar ? sl1 - stopBufAtr * atr15 : na) : (shBar > t.bar ? sh1 + stopBufAtr * atr15 : na)
                    if not na(cand) and (t.dir == 1 ? cand > t.stop and cand < close : cand < t.stop and cand > close)
                        t.stop := cand
                        line.set_xy1(t.lS, bar_index, cand)
                        line.set_xy2(t.lS, bar_index + 1, cand)
                        alert("[15M] " + syminfo.ticker + " move stop to " + f_px(cand) + " (T3: behind new 15M structure)", alert.freq_once_per_bar_close)

// ─────────────────────────────────────────────────────────────────────────────
// Zone execution: touch → trigger → structure shift → checks → order
// ─────────────────────────────────────────────────────────────────────────────
f_skip(string why) =>
    skips.put(why, nz(skips.get(why)) + 1)
    why

if barstate.isconfirmed and dBias != 0 and zones.size() > 0
    int dir = dBias
    int zi = 0
    for z in zones
        zi += 1
        bool touching = low <= z.hi and high >= z.lo
        if z.needLeave and (dir == 1 ? low > z.hi + 0.5 * atr15 : high < z.lo - 0.5 * atr15)
            z.needLeave := false
            z.status := "waiting for price"
        if not z.armed and not z.needLeave and touching
            z.armed   := true
            z.armBar  := bar_index
            z.sweep   := dir == 1 ? low : high
            z.trig    := false
            z.tap1    := na
            z.tap2    := na
            bool wasOther = false
            for j = 1 to brBars
                if dir == 1 ? close[j] < z.lo : close[j] > z.hi
                    wasOther := true
                    break
            z.setup  := wasOther ? "B" : "A"
            z.status := "in zone: waiting for trigger"
            nArms += 1
            if alertArm
                alert("[15M] " + syminfo.ticker + " in " + (dir == 1 ? "LONG" : "SHORT") + " Zone " + str.tostring(zi) + " " + f_px(z.lo) + "-" + f_px(z.hi) + ": waiting for a trigger", alert.freq_once_per_bar_close)
        if z.armed
            z.sweep := dir == 1 ? math.min(z.sweep, low) : math.max(z.sweep, high)
            bool failed  = dir == 1 ? close < z.inv : close > z.inv
            bool expired = bar_index - z.armBar > armBars
            if failed or expired
                z.armed     := false
                z.needLeave := true
                z.status    := failed ? "zone failed (closed beyond invalidation)" : "expired: wait for price to leave and return"
            else
                // Double-tap bookkeeping: confirmed 15M swing points inside the zone
                float tapPx = dir == 1 ? pl15 : ph15
                if not na(tapPx) and (dir == 1 ? tapPx <= z.hi + 0.1 * atr15 : tapPx >= z.lo - 0.1 * atr15)
                    z.tap1 := z.tap2
                    z.tap2 := tapPx
                // M8 approved triggers on the just-closed candle
                float rng   = high - low
                float body  = math.abs(close - open)
                bool  inBar = dir == 1 ? low <= z.hi + 0.1 * atr15 : high >= z.lo - 0.1 * atr15
                bool  inPrv = dir == 1 ? low[1] <= z.hi + 0.1 * atr15 : high[1] >= z.lo - 0.1 * atr15
                float wick  = dir == 1 ? math.min(open, close) - low : high - math.max(open, close)
                bool  tWick = inBar and rng > 0 and wick > 0 and wick >= wickMult * body and (dir == 1 ? close >= low + 0.5 * rng : close <= high - 0.5 * rng)
                bool  tEng  = (inBar or inPrv) and rng > 0 and (dir == 1 ? close > open and close[1] < open[1] and close >= open[1] and open <= close[1] and close >= low + engulfPos * rng : close < open and close[1] > open[1] and close <= open[1] and open >= close[1] and close <= high - engulfPos * rng)
                float shiftLvl = dir == 1 ? sh1 : sl1
                bool  shifted  = not na(shiftLvl) and (dir == 1 ? close > shiftLvl : close < shiftLvl)
                bool  tTap = not na(z.tap1) and not na(z.tap2) and (dir == 1 ? z.tap2 >= z.tap1 - dtapTol * atr15 : z.tap2 <= z.tap1 + dtapTol * atr15) and shifted
                if tTap or tEng or tWick
                    z.trig     := true
                    z.trigBar  := bar_index
                    z.trigName := tTap ? "2xTAP" : tEng ? "ENGULF" : "WICK"
                    z.status   := z.trigName + " seen: waiting for structure shift"
                    nTrig += 1
                // M9 structure shift (continuation exception: Setup B or 15M structure already with the trade)
                bool cont = z.setup == "B" or (dir == 1 ? sh1 > sh2 and sl1 > sl2 : sh1 < sh2 and sl1 < sl2)
                bool live = z.trig and bar_index - z.trigBar <= trigWindow
                if z.trig and not live
                    z.trig   := false
                    z.status := "trigger timed out: waiting for a new one"
                if live and (shifted or cont or z.trigName == "2xTAP")
                    nConf += 1
                    // ── M10-M16 checks ──
                    float buf   = stopBufAtr * atr15 + spreadPips * pip
                    float sl    = stopMode == "Sweep low/high" ? z.sweep - dir * buf : (dir == 1 ? math.min(z.sweep, z.lo) : math.max(z.sweep, z.hi)) - dir * buf
                    float refL  = shifted and not na(shiftLvl) ? shiftLvl : (dir == 1 ? z.hi : z.lo)
                    bool  chase = dir * (close - refL) > chaseAtr * atr15
                    float entry = chase ? refL : close
                    float tg = na
                    string tgName = ""
                    int tn = tgP.size()
                    if tn > 0
                        for i = 0 to tn - 1
                            float v = tgP.get(i)
                            bool beyond = dir == 1 ? v > math.max(entry, z.hi) + 0.1 * atr15 : v < math.min(entry, z.lo) - 0.1 * atr15
                            if beyond and (na(tg) or (dir == 1 ? v < tg : v > tg))
                                tg := v
                                tgName := tgN.get(i)
                    float riskPx = dir * (entry - sl)
                    float rr     = na(tg) or riskPx <= 0 ? na : dir * (tg - entry) / riskPx
                    [sPoc, sVah, sVal] = f_va(mpSes)
                    bool vwapFor   = dir == 1 ? close > vw : close < vw
                    bool vwapHard  = dir == 1 ? close < vw and vwDir == -1 : close > vw and vwDir == 1
                    bool svpHard   = not na(sVal) and (dir == 1 ? close < sVal : close > sVah)
                    bool volOk     = vol >= volMult * volMA
                    int  atRisk = 0
                    bool loser  = false
                    bool opposite = false
                    for t in trades
                        if t.dir * (t.stop - t.entry) < 0
                            atRisk += 1
                        if t.filled and t.dir * (close - t.entry) < 0
                            loser := true
                        if t.dir != dir
                            opposite := true
                    string why = ""
                    if riskPx <= 0
                        why := f_skip("stop not beyond entry")
                    else if chop
                        why := f_skip("15M chop (" + str.tostring(chopScore) + "/5 signs)")
                    else if newsBlock
                        why := f_skip("news within ±" + str.tostring(newsBuf) + " min")
                    else if not inWin
                        why := f_skip("outside entry window")
                    else if vwapHard and svpHard
                        why := f_skip("VWAP and SVP strongly against")
                    else if requireVol and not volOk
                        why := f_skip("weak volume")
                    else if na(tg)
                        why := f_skip("no target beyond entry")
                    else if rr < minRR
                        why := f_skip("only " + str.tostring(rr, "#.0") + "R before " + tgName)
                    else if trades.size() >= maxOpen
                        why := f_skip("max " + str.tostring(maxOpen) + " positions")
                    else if (atRisk + 1) * riskPct > maxOpenRisk + 1e-9
                        why := f_skip("open risk would exceed " + str.tostring(maxOpenRisk) + "%")
                    else if loser
                        why := f_skip("never add to a loser")
                    else if opposite
                        why := f_skip("opposite position open")
                    string side = dir == 1 ? "BUY" : "SELL"
                    if why == ""
                        float qStep = qtyStepIn > 0 ? qtyStepIn : isFx ? 1000 : syminfo.type == "crypto" ? 0.0001 : 1
                        float units = qRate > 0 ? math.floor(riskAmt / (riskPx * qRate * syminfo.pointvalue) / qStep) * qStep : na
                        if na(units) or units < qStep
                            why := f_skip("position size below the minimum quantity")
                        else
                            string id = (dir == 1 ? "L" : "S") + str.tostring(bar_index)
                            string tags = "Setup " + z.setup + " · " + z.trigName + (shifted ? " + shift" : " (continuation)") + " · VWAP " + (vwapFor ? "with" : "against") + " · Vol " + (volOk ? "OK" : "weak") + " · HMA55 " + (hfDir == dir ? "with" : hfDir == 0 ? "flat" : "against")
                            line lE = line.new(bar_index, entry, bar_index + 1, entry, color = color.gray, width = 2, extend = extend.right, style = chase ? line.style_dashed : line.style_solid)
                            line lS = line.new(bar_index, sl, bar_index + 1, sl, color = color.red, width = 2, extend = extend.right)
                            line lT = line.new(bar_index, tg, bar_index + 1, tg, color = color.green, width = 2, extend = extend.right)
                            label.new(bar_index, sl, "SL " + f_px(sl), style = label.style_label_right, color = color.new(color.red, 70), textcolor = color.white, size = size.tiny)
                            label.new(bar_index, tg, "TP " + f_px(tg), style = label.style_label_right, color = color.new(color.green, 70), textcolor = color.white, size = size.tiny)
                            trades.push(Trade.new(id, dir, bar_index, entry, sl, tg, riskPx, not chase, chase, lE, lS, lT))
                            nEntry += 1
                            nLimitPlaced += chase ? 1 : 0
                            lastScript := "I am trading " + (dir == 1 ? "LONG" : "SHORT") + " because Daily says " + dBiasTxt + ". My 4H zone is " + f_px(z.lo) + "-" + f_px(z.hi) + " because it contains " + z.names + ". On 15M, confirmation was " + z.trigName + (shifted ? " + structure shift through " + f_px(shiftLvl) : " (continuation retest)") + ". I am wrong at " + f_px(sl) + ". My target is " + f_px(tg) + " because it is the " + tgName + ". My risk is " + str.tostring(riskPct) + "%. " + (chase ? "Price ran past the anti-chase distance, so this is a LIMIT at the retest level." : "I am not chasing.")
                            string msg = "[15M] " + syminfo.ticker + " " + (chase ? side + " LIMIT @ " + f_px(entry) + " (valid " + str.tostring(limitBars) + " bars)" : "MARKET " + side + " @ " + f_px(entry)) + "\nSL " + f_px(sl) + " (" + str.tostring(riskPx / pip, "#.0") + (isFx ? " pips" : " bp") + ") · TP " + f_px(tg) + " (" + str.tostring(rr, "#.0") + "R, " + tgName + ")\nSize " + (isFx ? str.tostring(units / 100000, "#.00") + " lots" : str.tostring(units) + " " + syminfo.basecurrency) + " (" + str.tostring(riskPct) + "% = " + str.tostring(riskAmt, "#") + " " + accountCcy + ")\n" + tags + "\n" + lastScript
                            alert(msg, alert.freq_once_per_bar_close)
                            label.new(bar_index, dir == 1 ? low : high, (chase ? side + " LMT " : side + " ") + str.tostring(rr, "#.0") + "R", style = dir == 1 ? label.style_label_up : label.style_label_down, color = dir == 1 ? color.teal : color.red, textcolor = color.white, size = size.small, tooltip = msg)
                            z.status := (chase ? "limit signal" : "signal") + " given: wait for price to leave the zone"
                    if why != ""
                        z.status := "skipped: " + why
                        if showBlock
                            label.new(bar_index, dir == 1 ? low : high, "", yloc = dir == 1 ? yloc.belowbar : yloc.abovebar, style = label.style_xcross, color = color.gray, size = size.tiny, tooltip = side + " " + z.trigName + " at Zone " + str.tostring(zi) + " skipped: " + why)
                    z.armed     := false
                    z.trig      := false
                    z.needLeave := true

// ─────────────────────────────────────────────────────────────────────────────
// Table
// ─────────────────────────────────────────────────────────────────────────────
plot(vw, "VWAP", color.new(color.orange, 0))
plot(hF15, "HMA 55", hfDir == 1 ? color.teal : hfDir == -1 ? color.maroon : color.gray)
plot(dBias, "Daily bias", display = display.data_window)

var table tb = table.new(position.top_right, 2, 12, bgcolor = color.new(color.black, 20), border_width = 1)
f_row(int r, string k, string v, color c) =>
    table.cell(tb, 0, r, k, text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_left)

if barstate.islast and showTable
    f_row(0, "Daily bias", dBiasTxt + (dBias == 0 ? " · stand down" : "") + " · 4H " + (minCats == 2 ? "aligned (zones need 2+ categories)" : "not aligned (zones need 3+)"), dBias == 1 ? color.lime : dBias == -1 ? color.red : color.yellow)
    string z1 = zones.size() > 0 ? f_px(zones.get(0).lo) + "-" + f_px(zones.get(0).hi) + " [" + zones.get(0).cats + "] " + zones.get(0).names + " · invalid " + f_px(zones.get(0).inv) + " · " + zones.get(0).status : "none"
    string z2 = zones.size() > 1 ? f_px(zones.get(1).lo) + "-" + f_px(zones.get(1).hi) + " [" + zones.get(1).cats + "] · " + zones.get(1).status : "none"
    f_row(1, "Zone 1", z1, color.white)
    f_row(2, "Zone 2", z2, color.silver)
    f_row(3, "M2 chop", str.tostring(chopScore) + "/5 (flips " + str.tostring(cFlips) + ", 2-wick " + str.tostring(cWicks) + ", VWAP x" + str.tostring(cVwX) + ", sPOC x" + str.tostring(cPocX) + ", HMA55 " + (hfDir == 0 ? "flat" : "sloped") + ")" + (chop ? " · CHOP: wait" : ""), chop ? color.orange : color.white)
    f_row(4, "M3/M4 VWAP / SVP", "VWAP " + f_px(vw) + " " + (vwDir == 1 ? "rising" : vwDir == -1 ? "falling" : "flat") + " · price " + (close > vw ? "above" : "below") + " · session POC " + f_px(sesPoc), color.white)
    f_row(5, "News / window", (newsBlock ? "NEWS BLACKOUT" : newsMin.size() == 0 ? "no news times entered" : "clear") + (useWin ? " · window " + (inWin ? "open" : "closed") : ""), newsBlock ? color.orange : color.white)
    string opn = ""
    for t in trades
        opn := opn + (opn == "" ? "" : " | ") + (t.dir == 1 ? "BUY " : "SELL ") + (t.filled ? "" : "LIMIT ") + f_px(t.entry) + " SL " + f_px(t.stop) + " TP " + f_px(t.tp)
    f_row(6, "Open trades", trades.size() == 0 ? "none" : opn, color.white)
    f_row(7, "Results on this chart", nClosed == 0 ? "no closed trades yet" : str.tostring(nClosed) + " trades · " + str.tostring(100.0 * nWins / nClosed, "#") + "% win · avg " + str.tostring(sumR / nClosed, "#.##") + "R · total " + str.tostring(sumR, "#.#") + "R (after costs)", sumR >= 0 ? color.lime : color.red)
    f_row(8, "Funnel", str.tostring(nPlans) + " 4H plans → " + str.tostring(nBiasPlans) + " with Daily bias → " + str.tostring(nZonePlans) + " with a zone → " + str.tostring(nArms) + " zone touches → " + str.tostring(nTrig) + " triggers → " + str.tostring(nConf) + " confirmed → " + str.tostring(nEntry) + " signals (" + str.tostring(nLimitPlaced) + " limit)", color.white)
    string sk = ""
    array<string> keys = skips.keys()
    array<int> vals = array.new<int>()
    for k in keys
        vals.push(skips.get(k))
    if keys.size() > 0
        array<int> ord = vals.sort_indices(order.descending)
        for i = 0 to math.min(3, keys.size()) - 1
            int o = ord.get(i)
            sk := sk + (sk == "" ? "" : " · ") + keys.get(o) + " ×" + str.tostring(vals.get(o))
    f_row(9, "Top skip reasons", sk == "" ? "none yet" : sk, color.orange)
    f_row(10, "Last pre-click script", lastScript == "" ? "none yet" : lastScript, color.white)
    f_row(11, "Not checked here", "correlated USD exposure across pairs · revenge trading · anchors moved by hand", color.gray)
