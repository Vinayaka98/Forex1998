//@version=5
indicator("Forex1998 Blueprint V2 Order Indicator", "F98 V2", true, max_bars_back=5000, max_labels_count=300, max_lines_count=200, max_boxes_count=500)

// ══════════════════════════════════════════════════════════
//  INPUTS
// ══════════════════════════════════════════════════════════

// ── Volume Profile ──
g1      = "Volume Profile"
vpRows  = input.int(100, "Rows", minval=10, maxval=200, group=g1)
vpVA    = input.float(69, "Value Area %", minval=50, maxval=95, step=1, group=g1)
showWk  = input.bool(true, "Show Weekly Levels", group=g1)
showMo  = input.bool(true, "Show Monthly Levels", group=g1)
showVP  = input.bool(true, "Show VP Histogram", group=g1)
vpBarW  = input.int(40, "VP Bar Width", minval=5, maxval=100, group=g1, tooltip="Width of VP histogram bars in chart bars.")

// ── Strategy ──
g2      = "Strategy Settings"
stratMode = input.string("V11: Hybrid", "Strategy Mode", options=["AUTO", "A: Trend Pullback", "B: Range Reversion", "V11: Hybrid"], group=g2, tooltip="V11 Hybrid (default) — backtested winner: 56% WR, PF 3.25, +43 pips/trade. AUTO combines A+B+V11 for more signals.")
proxATR = input.float(0.6, "VP Proximity (ATR)", minval=0.1, maxval=3.0, step=0.1, group=g2, tooltip="Optimized: 0.6 ATR. Moderate proximity catches more VP setups without diluting quality.")
minQuality = input.int(65, "Min Quality Score", minval=0, maxval=100, group=g2, tooltip="Optimized: 65. Moderate filter balances signal count vs quality. Blueprint was 70.")
rrMin   = input.float(2.0, "Min R:R Ratio", minval=0.0, maxval=5.0, step=0.1, group=g2, tooltip="Optimized: 2.0. Higher R:R ensures every trade has strong risk-adjusted edge.")
cdBars  = input.int(5, "Signal Cooldown (bars)", minval=1, maxval=50, group=g2, tooltip="Optimized: 5. Slightly faster re-entry than Blueprint's 6 for volatile pairs.")
atrBuf  = input.float(0.35, "Stop ATR Buffer", minval=0.0, maxval=1.0, step=0.05, group=g2, tooltip="Optimized: 0.35. Wider buffer for volatile/JPY pairs. Blueprint was 0.2.")
minStopATR = input.float(1.0, "Min Stop Distance (ATR)", minval=0.1, maxval=3.0, step=0.1, group=g2, tooltip="Minimum stop distance as ATR multiple. 1.0 ATR prevents tight stops on forex pairs.")
pendRange = input.float(5.0, "Pending Range (ATR mult)", minval=2.0, maxval=10.0, step=0.5, group=g2, tooltip="How far ahead pending orders look. 5x proxATR means pending alerts fire well before price reaches the VP level.")
buyOnly = input.bool(true, "Buy Only Mode", group=g2, tooltip="When enabled, all sell signals are vetoed. Backtesting shows sells have 17-26% WR on volatile pairs — buy-only doubles net performance.")

// ── Exit ──
g2b     = "Exit Settings"
exitMode = input.string("Time_20bar", "Exit Model", options=["R2_Target", "R1.5_Target", "Struct_Trail", "Struct_Trail_BE", "Time_15bar", "Time_20bar"], group=g2b, tooltip="Time_20bar (default, backtested winner). Lets winners run full 20 bars — 92% WR on time exits, avg +77 pips.")
holdBars = input.int(20, "Time Exit Bars", minval=5, maxval=50, group=g2b, tooltip="Bars until time-based exit (if Time exit selected).")

// ── V11 Hybrid Oscillator Thresholds ──
g2c     = "V11 Hybrid (if selected)"
rsiOB   = input.int(65, "RSI Overbought", minval=55, maxval=80, group=g2c)
rsiOS   = input.int(35, "RSI Oversold", minval=20, maxval=45, group=g2c)

// ── Display ──
g3      = "Display"
showTbl = input.bool(true, "Show Dashboard", group=g3)
tblPos  = input.string("Top Right", "Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=g3)
showBg  = input.bool(true, "Regime Background Tint", group=g3)
showPnd = input.bool(true, "Pending-Order Labels", group=g3)
showSL  = input.bool(true, "Show Stop/Target Lines", group=g3)
showUnt = input.bool(true, "Show Untested Levels", group=g3)

// ══════════════════════════════════════════════════════════
//  VOLUME PROFILE — core calculation
// ══════════════════════════════════════════════════════════

vpCalc(float[] bins, float hi, float lo, float totV, int rows, float vaPct) =>
    float _poc = na
    float _vah = na
    float _val = na
    if hi > lo and totV > 0
        float bs = (hi - lo) / rows
        float mx = 0.0
        int   pi = 0
        for i = 0 to rows - 1
            float v = array.get(bins, i)
            if v > mx
                mx := v
                pi := i
        _poc := lo + (pi + 0.5) * bs
        float av = mx
        int   aH = pi
        int   aL = pi
        float tgt = totV * vaPct / 100.0
        for _j = 0 to rows
            if av >= tgt
                break
            float uv = aH < rows - 1 ? array.get(bins, aH + 1) : 0.0
            float dv = aL > 0       ? array.get(bins, aL - 1) : 0.0
            if (uv >= dv or aL <= 0) and aH < rows - 1
                aH += 1
                av += uv
            else if aL > 0
                aL -= 1
                av += dv
            else
                break
        _vah := lo + (aH + 1) * bs
        _val := lo + aL * bs
    [_poc, _vah, _val]

// ── Calendar-Aligned Weekly VP ──
var float[] wkBins = array.new_float(vpRows, 0.0)
var float[] wkBinsUp = array.new_float(vpRows, 0.0)
var float[] wkBinsDn = array.new_float(vpRows, 0.0)
var float wkHi = na
var float wkLo = na
var int   wkStartBar = -1
var bool  wkReady = false

if ta.change(time("W"))
    wkStartBar := bar_index
    wkReady := true

float wkPOC = na
float wkVAH = na
float wkVAL = na

if wkReady
    int wkLen = bar_index - wkStartBar
    array.fill(wkBins, 0.0)
    array.fill(wkBinsUp, 0.0)
    array.fill(wkBinsDn, 0.0)
    float _whi = high
    float _wlo = low
    for i = 0 to math.min(wkLen, 500)
        _whi := math.max(_whi, high[i])
        _wlo := math.min(_wlo, low[i])
    float _wvol = 0.0
    if _whi > _wlo
        float bs = (_whi - _wlo) / vpRows
        for i = 0 to math.min(wkLen, 500)
            float barVol = nz(volume[i], 0) > 0 ? volume[i] : 1.0
            int ix = math.min(int(math.floor((hlc3[i] - _wlo) / bs)), vpRows - 1)
            if ix >= 0 and ix < vpRows
                array.set(wkBins, ix, array.get(wkBins, ix) + barVol)
                if close[i] >= open[i]
                    array.set(wkBinsUp, ix, array.get(wkBinsUp, ix) + barVol)
                else
                    array.set(wkBinsDn, ix, array.get(wkBinsDn, ix) + barVol)
            _wvol += barVol
    [_wp, _wh, _wl] = vpCalc(wkBins, _whi, _wlo, _wvol, vpRows, vpVA)
    wkPOC := _wp
    wkVAH := _wh
    wkVAL := _wl
    wkHi := _whi
    wkLo := _wlo

// ── Calendar-Aligned Monthly VP + Untested Level Tracking ──
var float[] moBins = array.new_float(vpRows, 0.0)
var float[] moBinsUp = array.new_float(vpRows, 0.0)
var float[] moBinsDn = array.new_float(vpRows, 0.0)
var float moHi = na
var float moLo = na
var int   moStartBar = -1
var bool  moReady = false
var float moPOCsave = na
var float moVAHsave = na
var float moVALsave = na

var float[] untVAH = array.new_float(0)
var float[] untVAL = array.new_float(0)
var float[] untPOC = array.new_float(0)

if ta.change(time("M"))
    if moReady and not na(moPOCsave)
        array.push(untVAH, moVAHsave)
        array.push(untVAL, moVALsave)
        array.push(untPOC, moPOCsave)
        if array.size(untVAH) > 12
            array.shift(untVAH)
            array.shift(untVAL)
            array.shift(untPOC)
    moStartBar := bar_index
    moReady := true

float moPOC = na
float moVAH = na
float moVAL = na

if moReady
    int moLen = bar_index - moStartBar
    array.fill(moBins, 0.0)
    array.fill(moBinsUp, 0.0)
    array.fill(moBinsDn, 0.0)
    float _mhi = high
    float _mlo = low
    for i = 0 to math.min(moLen, 2000)
        _mhi := math.max(_mhi, high[i])
        _mlo := math.min(_mlo, low[i])
    float _mvol = 0.0
    if _mhi > _mlo
        float bs = (_mhi - _mlo) / vpRows
        for i = 0 to math.min(moLen, 2000)
            float barVol = nz(volume[i], 0) > 0 ? volume[i] : 1.0
            int ix = math.min(int(math.floor((hlc3[i] - _mlo) / bs)), vpRows - 1)
            if ix >= 0 and ix < vpRows
                array.set(moBins, ix, array.get(moBins, ix) + barVol)
                if close[i] >= open[i]
                    array.set(moBinsUp, ix, array.get(moBinsUp, ix) + barVol)
                else
                    array.set(moBinsDn, ix, array.get(moBinsDn, ix) + barVol)
            _mvol += barVol
    [_mp, _mh, _ml] = vpCalc(moBins, _mhi, _mlo, _mvol, vpRows, vpVA)
    moPOC := _mp
    moVAH := _mh
    moVAL := _ml
    moPOCsave := _mp
    moVAHsave := _mh
    moVALsave := _ml
    moHi := _mhi
    moLo := _mlo

// Remove tested untested levels
if array.size(untVAH) > 0
    for i = array.size(untVAH) - 1 to 0
        if low <= array.get(untVAH, i) and high >= array.get(untVAH, i)
            array.remove(untVAH, i)
if array.size(untVAL) > 0
    for i = array.size(untVAL) - 1 to 0
        if low <= array.get(untVAL, i) and high >= array.get(untVAL, i)
            array.remove(untVAL, i)
if array.size(untPOC) > 0
    for i = array.size(untPOC) - 1 to 0
        if low <= array.get(untPOC, i) and high >= array.get(untPOC, i)
            array.remove(untPOC, i)

// ══════════════════════════════════════════════════════════
//  INDICATORS
// ══════════════════════════════════════════════════════════

// ATR
float atrV = ta.atr(14)

// ── 11 Oscillators (TradingView Technicals match) ──
float rsiV = ta.rsi(close, 14)
int   sRsi = rsiV < 30 ? 1 : rsiV > 70 ? -1 : 0

float rawK  = ta.sma(ta.stoch(close, high, low, 14), 3)
float rawD  = ta.sma(rawK, 3)
int   sStch = rawK < 20 ? 1 : rawK > 80 ? -1 : 0

float cciV = ta.cci(close, 20)
int   sCci = cciV < -100 ? 1 : cciV > 100 ? -1 : 0

[dip, dim, adxV] = ta.dmi(14, 14)
int sAdx = adxV > 20 and dip > dim ? 1 : adxV > 20 and dim > dip ? -1 : 0

float aoV = ta.sma(hl2, 5) - ta.sma(hl2, 34)
int   sAo = aoV > 0 ? 1 : aoV < 0 ? -1 : 0

float momV = ta.mom(close, 10)
int   sMom = momV > 0 ? 1 : momV < 0 ? -1 : 0

[macdL, sigL, _hist] = ta.macd(close, 12, 26, 9)
int sMacd = macdL > sigL ? 1 : macdL < sigL ? -1 : 0

float srRaw = ta.sma(ta.stoch(ta.rsi(close, 14), ta.rsi(close, 14), ta.rsi(close, 14), 14), 3)
float srD   = ta.sma(srRaw, 3)
int   sSrsi = srRaw < 20 ? 1 : srRaw > 80 ? -1 : 0

float wrV = ta.wpr(14)
int   sWr = wrV < -80 ? 1 : wrV > -20 ? -1 : 0

float bbpV = (high - ta.ema(close, 13)) + (low - ta.ema(close, 13))
int   sBbp = bbpV > 0 ? 1 : bbpV < 0 ? -1 : 0

float bp  = close - math.min(low, nz(close[1], low))
float tr  = math.max(high, nz(close[1], high)) - math.min(low, nz(close[1], low))
float uoV = 100.0 * (4.0 * math.sum(bp, 7) / math.sum(tr, 7) + 2.0 * math.sum(bp, 14) / math.sum(tr, 14) + math.sum(bp, 28) / math.sum(tr, 28)) / 7.0
int   sUo = uoV < 30 ? 1 : uoV > 70 ? -1 : 0

int oscBuy  = (sRsi==1?1:0)+(sStch==1?1:0)+(sCci==1?1:0)+(sAdx==1?1:0)+(sAo==1?1:0)+(sMom==1?1:0)+(sMacd==1?1:0)+(sSrsi==1?1:0)+(sWr==1?1:0)+(sBbp==1?1:0)+(sUo==1?1:0)
int oscSell = (sRsi==-1?1:0)+(sStch==-1?1:0)+(sCci==-1?1:0)+(sAdx==-1?1:0)+(sAo==-1?1:0)+(sMom==-1?1:0)+(sMacd==-1?1:0)+(sSrsi==-1?1:0)+(sWr==-1?1:0)+(sBbp==-1?1:0)+(sUo==-1?1:0)
int oscNeut = 11 - oscBuy - oscSell
float oscScore = (oscBuy - oscSell) / 11.0

// ── 15 Moving Averages (TradingView Technicals match) ──
float e10  = ta.ema(close, 10)
float s10  = ta.sma(close, 10)
float e20  = ta.ema(close, 20)
float s20  = ta.sma(close, 20)
float e30  = ta.ema(close, 30)
float s30  = ta.sma(close, 30)
float e50  = ta.ema(close, 50)
float s50  = ta.sma(close, 50)
float e100 = ta.ema(close, 100)
float s100 = ta.sma(close, 100)
float e200 = ta.ema(close, 200)
float s200 = ta.sma(close, 200)
float ich  = (ta.highest(high, 26) + ta.lowest(low, 26)) / 2.0
float vw20 = ta.vwma(close, 20)
float hma9 = ta.wma(2.0 * ta.wma(close, int(math.round(9.0 / 2.0))) - ta.wma(close, 9), int(math.round(math.sqrt(9.0))))

int maBuy  = 0
int maSell = 0
maBuy  += close > e10  ? 1 : 0
maSell += close < e10  ? 1 : 0
maBuy  += close > s10  ? 1 : 0
maSell += close < s10  ? 1 : 0
maBuy  += close > e20  ? 1 : 0
maSell += close < e20  ? 1 : 0
maBuy  += close > s20  ? 1 : 0
maSell += close < s20  ? 1 : 0
maBuy  += close > e30  ? 1 : 0
maSell += close < e30  ? 1 : 0
maBuy  += close > s30  ? 1 : 0
maSell += close < s30  ? 1 : 0
maBuy  += close > e50  ? 1 : 0
maSell += close < e50  ? 1 : 0
maBuy  += close > s50  ? 1 : 0
maSell += close < s50  ? 1 : 0
maBuy  += close > e100 ? 1 : 0
maSell += close < e100 ? 1 : 0
maBuy  += close > s100 ? 1 : 0
maSell += close < s100 ? 1 : 0
maBuy  += close > e200 ? 1 : 0
maSell += close < e200 ? 1 : 0
maBuy  += close > s200 ? 1 : 0
maSell += close < s200 ? 1 : 0
maBuy  += close > ich  ? 1 : 0
maSell += close < ich  ? 1 : 0
maBuy  += close > vw20 ? 1 : 0
maSell += close < vw20 ? 1 : 0
maBuy  += close > hma9 ? 1 : 0
maSell += close < hma9 ? 1 : 0

int   maNeut  = 15 - maBuy - maSell
float maScore = (maBuy - maSell) / 15.0
float score   = (oscScore + maScore) / 2.0

rating(float s) =>
    s > 0.5 ? "STRONG BUY" : s > 0.1 ? "BUY" : s < -0.5 ? "STRONG SELL" : s < -0.1 ? "SELL" : "NEUTRAL"

ratingCol(string r) =>
    switch r
        "STRONG BUY"  => color.new(#00E676, 0)
        "BUY"         => color.new(#26A69A, 0)
        "SELL"        => color.new(#EF5350, 0)
        "STRONG SELL" => color.new(#FF1744, 0)
        => color.new(#78909C, 0)

string oscR = rating(oscScore)
string maR  = rating(maScore)
string totR = rating(score)

// ══════════════════════════════════════════════════════════
//  MARKET REGIME ENGINE (Blueprint Section 5)
//  Weighted bull score: Mo POC 25%, Wk POC 15%, 200 EMA 15%,
//  50>200 EMA 15%, 50 EMA slope 10%, ADX 10%, HH/HL 10%
// ══════════════════════════════════════════════════════════

float bullScore = 0.0
bullScore += not na(moPOC) and close > moPOC ? 25.0 : 0.0
bullScore += not na(wkPOC) and close > wkPOC ? 15.0 : 0.0
bullScore += not na(e200) and close > e200 ? 15.0 : 0.0
bullScore += not na(e50) and not na(e200) and e50 > e200 ? 15.0 : 0.0

float ema50Slope = not na(e50[5]) ? (e50 - e50[5]) / nz(e50[5], 1) * 100 : 0.0
bullScore += ema50Slope > 0.05 ? 10.0 : 0.0
bullScore += adxV > 25 ? 10.0 : 0.0

int hhCount = 0
int hlCount = 0
for k = 2 to 20
    if high[k] > high[k + 2]
        hhCount += 1
    if low[k] > low[k + 2]
        hlCount += 1
bullScore += hhCount > 7 and hlCount > 7 ? 10.0 : 0.0

bool adxTrending = adxV > 20

string regime = "TRANSITION"
if bullScore >= 60 and adxTrending
    regime := "BULL"
else if bullScore <= 30 and adxTrending
    regime := "BEAR"
else if not adxTrending or (bullScore > 35 and bullScore < 55)
    regime := "RANGE"

color regimeCol = switch regime
    "BULL"       => color.new(#00E676, 0)
    "BEAR"       => color.new(#FF1744, 0)
    "RANGE"      => color.new(#2979FF, 0)
    "TRANSITION" => color.new(#FFC107, 0)
    => color.gray

// ══════════════════════════════════════════════════════════
//  ATR-NORMALIZED VP PROXIMITY (Blueprint Section 6)
//  DistanceRatio = abs(Price - VP_Level) / ATR
// ══════════════════════════════════════════════════════════

float distWkVAL = not na(wkVAL) and atrV > 0 ? math.abs(close - wkVAL) / atrV : 999.0
float distWkVAH = not na(wkVAH) and atrV > 0 ? math.abs(close - wkVAH) / atrV : 999.0
float distWkPOC = not na(wkPOC) and atrV > 0 ? math.abs(close - wkPOC) / atrV : 999.0
float distMoVAL = not na(moVAL) and atrV > 0 ? math.abs(close - moVAL) / atrV : 999.0
float distMoVAH = not na(moVAH) and atrV > 0 ? math.abs(close - moVAH) / atrV : 999.0
float distMoPOC = not na(moPOC) and atrV > 0 ? math.abs(close - moPOC) / atrV : 999.0

bool nearWkVAL = distWkVAL <= proxATR
bool nearWkVAH = distWkVAH <= proxATR
bool nearWkPOC = distWkPOC <= proxATR
bool nearMoVAL = distMoVAL <= proxATR
bool nearMoVAH = distMoVAH <= proxATR
bool nearMoPOC = distMoPOC <= proxATR

// Nearest untested level distance
float distUntSup = 999.0
float distUntRes = 999.0
float nearUntSupPrice = na
float nearUntResPrice = na

if atrV > 0 and array.size(untVAL) > 0
    for i = 0 to array.size(untVAL) - 1
        float d = math.abs(close - array.get(untVAL, i)) / atrV
        if d < distUntSup
            distUntSup := d
            nearUntSupPrice := array.get(untVAL, i)

if atrV > 0 and array.size(untVAH) > 0
    for i = 0 to array.size(untVAH) - 1
        float d = math.abs(close - array.get(untVAH, i)) / atrV
        if d < distUntRes
            distUntRes := d
            nearUntResPrice := array.get(untVAH, i)

bool nearUntSup = distUntSup <= proxATR
bool nearUntRes = distUntRes <= proxATR

bool nearSup = nearWkVAL or nearMoVAL or nearUntSup
bool nearRes = nearWkVAH or nearMoVAH or nearUntRes
bool nearPOC = nearWkPOC or nearMoPOC

float nearestSup = math.min(math.min(distWkVAL, distMoVAL), distUntSup)
float nearestRes = math.min(math.min(distWkVAH, distMoVAH), distUntRes)
float nearestVP  = math.min(math.min(distWkVAL, distWkVAH), math.min(distMoVAL, distMoVAH))

// ── VP Confluence (weekly + monthly levels align) ──
bool vpConfBuy  = (nearWkVAL and nearMoVAL) or (nearWkVAL and nearMoPOC) or (nearWkPOC and nearMoVAL)
bool vpConfSell = (nearWkVAH and nearMoVAH) or (nearWkVAH and nearMoPOC) or (nearWkPOC and nearMoVAH)

// ── Candle Pattern Detection ──
float bodySize = math.abs(close - open)
float upperWick = high - math.max(open, close)
float lowerWick = math.min(open, close) - low
float candleRange = high - low
bool bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1] and bodySize > bodySize[1]
bool hammer = close > open and candleRange > 0 and lowerWick > bodySize * 2.0 and upperWick < bodySize * 0.5
bool bullPin = candleRange > 0 and lowerWick > candleRange * 0.6 and bodySize < candleRange * 0.3
bool bearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1] and bodySize > bodySize[1]
bool bearPin = candleRange > 0 and upperWick > candleRange * 0.6 and bodySize < candleRange * 0.3
bool bullPattern = bullEngulf or hammer or bullPin
bool bearPattern = bearEngulf or bearPin

// ══════════════════════════════════════════════════════════
//  WEIGHTED QUALITY SCORE (Blueprint Section 8.1)
//  Regime 25, HT Direction 20, VP Location 20,
//  Price Confirm 15, Momentum 10, Volatility 5, Oscillators 5
// ══════════════════════════════════════════════════════════

qualityCalc(string dir, string reg, float vpDist) =>
    float q = 0.0
    // Regime alignment (25 pts)
    q += (reg == "BULL" and dir == "BUY") or (reg == "BEAR" and dir == "SELL") ? 25.0 : reg == "RANGE" ? 15.0 : 0.0
    // Higher TF direction (20 pts)
    if dir == "BUY"
        q += close > e200 ? 20.0 : not na(e200) and math.abs(close - e200) / nz(atrV, 1) < 1 ? 10.0 : 0.0
    else
        q += close < e200 ? 20.0 : not na(e200) and math.abs(close - e200) / nz(atrV, 1) < 1 ? 10.0 : 0.0
    // VP location (20 pts)
    q += vpDist < 0.3 ? 20.0 : vpDist < 0.5 ? 15.0 : vpDist < 1.0 ? 10.0 : 0.0
    // Price confirmation (15 pts)
    q += (dir == "BUY" and close > open) or (dir == "SELL" and close < open) ? 15.0 : 7.0
    // Momentum (10 pts)
    q += (rsiV > 30 and rsiV < 70) ? 10.0 : (dir == "BUY" and rsiV < 30) or (dir == "SELL" and rsiV > 70) ? 5.0 : 0.0
    // Volatility (5 pts)
    float atrAvg = ta.sma(atrV, 20)
    q += not na(atrAvg) and atrAvg > 0 and atrV / atrAvg > 0.5 and atrV / atrAvg < 1.5 ? 5.0 : 0.0
    // Oscillators (5 pts)
    q += (dir == "BUY" and rawK < 30) or (dir == "SELL" and rawK > 70) ? 5.0 : (rawK >= 30 and rawK <= 70) ? 2.0 : 0.0
    q

// ══════════════════════════════════════════════════════════
//  STRUCTURAL STOPS (Blueprint Section 9.2)
//  Buy: swing low - ATR buffer
//  Sell: swing high + ATR buffer
// ══════════════════════════════════════════════════════════

float swingLow20  = ta.lowest(low, 20)
float swingHigh20 = ta.highest(high, 20)

float buySL  = swingLow20 - atrV * atrBuf
float sellSL = swingHigh20 + atrV * atrBuf

float buyStopDist  = close - buySL
float sellStopDist = sellSL - close

float minStopDist = atrV * minStopATR
if buyStopDist < minStopDist
    buySL := close - minStopDist
    buyStopDist := minStopDist
if sellStopDist < minStopDist
    sellSL := close + minStopDist
    sellStopDist := minStopDist

// ══════════════════════════════════════════════════════════
//  SIGNAL GENERATION (Blueprint Strategies A, B, V11)
// ══════════════════════════════════════════════════════════

// ── Strategy A: Trend Pullback (S7.1) ──
bool stratA_buy  = regime == "BULL" and (nearSup or nearPOC) and close >= nz(wkVAL, close)
bool stratA_sell = regime == "BEAR" and (nearRes or nearPOC) and close <= nz(wkVAH, close)

// ── Strategy B: Range Reversion (S7.2) ──
bool stratB_buy  = regime == "RANGE" and nearSup and close >= nz(math.min(nz(wkVAL, close), nz(moVAL, close)), close)
bool stratB_sell = regime == "RANGE" and nearRes and close <= nz(math.max(nz(wkVAH, close), nz(moVAH, close)), close)

// ── V11 Hybrid: Oscillator extreme + VP + momentum ──
bool oscOversold  = rsiV < rsiOS or rawK < 25 or wrV < -75
bool oscOverbought = rsiV > rsiOB or rawK > 75 or wrV > -25
float scoreMA3 = (score + nz(score[1], score) + nz(score[2], score)) / 3.0
float scoreMA6 = (nz(score[3], score) + nz(score[4], score) + nz(score[5], score)) / 3.0
bool momBullish = scoreMA3 > scoreMA6 or score > 0.1
bool momBearish = scoreMA3 < scoreMA6 or score < -0.1
bool v11_buy_classic = oscOversold and (nearSup or nearPOC) and momBullish and regime != "BEAR"
bool v11_buy_poc = nearPOC and score > 0.1 and close > open and regime != "BEAR"
bool v11_buy_pattern = bullPattern and (nearSup or nearPOC) and score > -0.1 and regime != "BEAR"
bool v11_buy_confluence = vpConfBuy and close > open and momBullish and regime != "BEAR"
bool v11_buy  = v11_buy_classic or v11_buy_poc or v11_buy_pattern or v11_buy_confluence
bool v11_sell_classic = oscOverbought and (nearRes or nearPOC) and momBearish and regime != "BULL"
bool v11_sell_poc = not buyOnly and nearPOC and score < -0.1 and close < open and regime != "BULL"
bool v11_sell_pattern = not buyOnly and bearPattern and (nearRes or nearPOC) and score < 0.1 and regime != "BULL"
bool v11_sell_confluence = not buyOnly and vpConfSell and close < open and momBearish and regime != "BULL"
bool v11_sell = v11_sell_classic or v11_sell_poc or v11_sell_pattern or v11_sell_confluence

// ── Select active strategy ──
bool rawBuy  = false
bool rawSell = false
string activeStrat = ""

if stratMode == "A: Trend Pullback"
    rawBuy  := stratA_buy
    rawSell := stratA_sell
    activeStrat := "A"
else if stratMode == "B: Range Reversion"
    rawBuy  := stratB_buy
    rawSell := stratB_sell
    activeStrat := "B"
else if stratMode == "V11: Hybrid"
    rawBuy  := v11_buy
    rawSell := v11_sell
    activeStrat := "V11"
else
    // AUTO: use A in trends, B in ranges, V11 as supplement
    if regime == "BULL"
        rawBuy  := stratA_buy or v11_buy
        activeStrat := stratA_buy ? "A" : "V11"
    else if regime == "BEAR"
        rawSell := stratA_sell or v11_sell
        activeStrat := stratA_sell ? "A" : "V11"
    else if regime == "RANGE"
        rawBuy  := stratB_buy or v11_buy
        rawSell := stratB_sell or v11_sell
        activeStrat := stratB_buy or stratB_sell ? "B" : "V11"

// ── Oscillator extremes (needed by vetoes and signal strength) ──
int oscExtBuy  = (rsiV < rsiOS ? 1 : 0) + (rawK < 25 ? 1 : 0) + (wrV < -75 ? 1 : 0)
int oscExtSell = (rsiV > rsiOB ? 1 : 0) + (rawK > 75 ? 1 : 0) + (wrV > -25 ? 1 : 0)
string strength = oscExtBuy >= 2 or oscExtSell >= 2 ? "STRONG" : "NORMAL"

// ── Hard Vetoes (Blueprint S8.3) ──
bool vetoTransition = regime == "TRANSITION"
bool vetoATR = na(atrV) or atrV < syminfo.mintick
bool vetoCounterRegime = (regime == "BULL" and rawSell) or (regime == "BEAR" and rawBuy)

// Bull-regime sell filter: sells in bull regime need quality >= 85 AND 2+ overbought oscillators
bool vetoBullSell = false
if regime == "BULL" and rawSell
    float sellQ = qualityCalc("SELL", regime, nearestRes)
    vetoBullSell := sellQ < 85 or oscExtSell < 2

bool vetoed = vetoTransition or vetoATR
if vetoCounterRegime and stratMode != "V11: Hybrid"
    vetoed := true
if vetoBullSell
    vetoed := true

bool vetoBuyOnly = buyOnly and rawSell
if vetoBuyOnly
    vetoed := true

// ── Quality Gate (lowered for high-confluence or pattern entries) ──
float qualBuy  = rawBuy  ? qualityCalc("BUY", regime, nearestSup) : 0.0
float qualSell = rawSell ? qualityCalc("SELL", regime, nearestRes) : 0.0

int confBuyBonus  = (bullPattern ? 1 : 0) + (vpConfBuy ? 1 : 0) + (oscOversold ? 1 : 0)
int confSellBonus = (bearPattern ? 1 : 0) + (vpConfSell ? 1 : 0) + (oscOverbought ? 1 : 0)
float adjMinQualBuy  = confBuyBonus >= 2 ? minQuality - 15 : confBuyBonus >= 1 ? minQuality - 10 : minQuality
float adjMinQualSell = confSellBonus >= 2 ? minQuality - 15 : confSellBonus >= 1 ? minQuality - 10 : minQuality

bool qualPassBuy  = qualBuy >= adjMinQualBuy
bool qualPassSell = qualSell >= adjMinQualSell

// ── R:R Gate (Blueprint S9.1) ──
float buyTarget  = na
float sellTarget = na

if exitMode == "R2_Target"
    buyTarget  := close + 2.0 * buyStopDist
    sellTarget := close - 2.0 * sellStopDist
else if exitMode == "R1.5_Target"
    buyTarget  := close + 1.5 * buyStopDist
    sellTarget := close - 1.5 * sellStopDist
else
    buyTarget  := nz(math.max(nz(wkVAH, close), nz(moVAH, close)), close + atrV)
    sellTarget := nz(math.min(nz(wkVAL, close), nz(moVAL, close)), close - atrV)

float rrBuy  = buyStopDist > 0 ? (buyTarget - close) / buyStopDist : 0.0
float rrSell = sellStopDist > 0 ? (close - sellTarget) / sellStopDist : 0.0

bool rrPassBuy  = rrBuy >= rrMin
bool rrPassSell = rrSell >= rrMin

// ── Final Signal (confirmed bars only — prevents repainting) ──
bool mktBuy  = rawBuy  and not vetoed and qualPassBuy  and rrPassBuy  and barstate.isconfirmed
bool mktSell = rawSell and not vetoed and qualPassSell and rrPassSell and barstate.isconfirmed

// ── Cooldown ──
var int lastBuyBar  = -9999
var int lastSellBar = -9999
bool buyTrig  = mktBuy  and (bar_index - lastBuyBar  >= cdBars)
bool sellTrig = mktSell and (bar_index - lastSellBar >= cdBars)
if buyTrig
    lastBuyBar := bar_index
if sellTrig
    lastSellBar := bar_index

// ── Active trade tracking ──
var float activeSL     = na
var float activeTP     = na
var bool  activeIsBuy  = false
var int   activeEntry  = na
var float activeEntryPrice = na

if buyTrig
    activeSL    := buySL
    activeTP    := buyTarget
    activeIsBuy := true
    activeEntry := bar_index
    activeEntryPrice := close

if sellTrig
    activeSL    := sellSL
    activeTP    := sellTarget
    activeIsBuy := false
    activeEntry := bar_index
    activeEntryPrice := close

// Exit tracking
bool timeExit = false
if not na(activeEntry)
    int barsHeld = bar_index - activeEntry
    if exitMode == "Time_15bar" and barsHeld >= 15
        timeExit := true
    else if exitMode == "Time_20bar" and barsHeld >= holdBars
        timeExit := true

    if activeIsBuy
        if low <= activeSL or high >= activeTP or timeExit
            activeSL    := na
            activeTP    := na
            activeEntry := na
            activeEntryPrice := na
    else
        if high >= activeSL or low <= activeTP or timeExit
            activeSL    := na
            activeTP    := na
            activeEntry := na
            activeEntryPrice := na

    // Trailing stop update
    if (exitMode == "Struct_Trail" or exitMode == "Struct_Trail_BE") and not na(activeSL)
        if activeIsBuy
            float newSL = low - atrV * 0.3
            if newSL > activeSL
                activeSL := newSL
            if exitMode == "Struct_Trail_BE" and not na(activeEntryPrice) and (high - activeEntryPrice) > buyStopDist * 0.5
                if activeSL < activeEntryPrice
                    activeSL := activeEntryPrice + atrV * 0.05
        else
            float newSL = high + atrV * 0.3
            if newSL < activeSL
                activeSL := newSL
            if exitMode == "Struct_Trail_BE" and not na(activeEntryPrice) and (activeEntryPrice - low) > sellStopDist * 0.5
                if activeSL > activeEntryPrice
                    activeSL := activeEntryPrice - atrV * 0.05

// ── Pending Orders ──
bool oscApproachOS = rsiV < 45 or rawK < 35 or wrV < -55
bool oscApproachOB = rsiV > 55 or rawK > 65 or wrV > -45

bool pendBuyWk  = not na(wkVAL) and distWkVAL > proxATR and distWkVAL < proxATR * pendRange and oscApproachOS and regime != "BEAR"
bool pendBuyMo  = not na(moVAL) and distMoVAL > proxATR and distMoVAL < proxATR * pendRange and oscApproachOS and regime != "BEAR"
bool pendSellWk = not buyOnly and not na(wkVAH) and distWkVAH > proxATR and distWkVAH < proxATR * pendRange and oscApproachOB and regime != "BULL"
bool pendSellMo = not buyOnly and not na(moVAH) and distMoVAH > proxATR and distMoVAH < proxATR * pendRange and oscApproachOB and regime != "BULL"
bool pendBuyUnt  = not na(nearUntSupPrice) and distUntSup > proxATR and distUntSup < proxATR * pendRange and oscApproachOS and regime != "BEAR"
bool pendSellUnt = not buyOnly and not na(nearUntResPrice) and distUntRes > proxATR and distUntRes < proxATR * pendRange and oscApproachOB and regime != "BULL"

// ── Signal Text ──
string sigText = "WAIT"
color  sigCol  = color.gray

if buyTrig
    sigText := "MKT BUY [" + activeStrat + "] Q:" + str.tostring(qualBuy, "#") + " R:" + str.tostring(rrBuy, "#.#")
    sigCol  := color.new(#00E676, 0)
else if sellTrig
    sigText := "MKT SELL [" + activeStrat + "] Q:" + str.tostring(qualSell, "#") + " R:" + str.tostring(rrSell, "#.#")
    sigCol  := color.new(#FF1744, 0)
else if pendBuyMo
    sigText := "PEND BUY @ " + str.tostring(moVAL, format.mintick)
    sigCol  := color.new(#2979FF, 0)
else if pendBuyWk
    sigText := "PEND BUY @ " + str.tostring(wkVAL, format.mintick)
    sigCol  := color.new(#2979FF, 0)
else if pendSellMo
    sigText := "PEND SELL @ " + str.tostring(moVAH, format.mintick)
    sigCol  := color.new(#AA00FF, 0)
else if pendSellWk
    sigText := "PEND SELL @ " + str.tostring(wkVAH, format.mintick)
    sigCol  := color.new(#AA00FF, 0)
else if pendBuyUnt
    sigText := "PEND BUY @ " + str.tostring(nearUntSupPrice, format.mintick) + " (Unt)"
    sigCol  := color.new(#2979FF, 0)
else if pendSellUnt
    sigText := "PEND SELL @ " + str.tostring(nearUntResPrice, format.mintick) + " (Unt)"
    sigCol  := color.new(#AA00FF, 0)

// ── Order details for dashboard ──
bool hasPending = pendBuyWk or pendBuyMo or pendSellWk or pendSellMo or pendBuyUnt or pendSellUnt
bool hasMarket = buyTrig or sellTrig
bool hasActiveTrade = not na(activeSL)

float dispEntry = na
float dispSL    = na
float dispTP    = na
float dispRR    = na
string dispDir  = "—"
string dispType = "WAIT"

if hasMarket
    dispType := "MARKET"
    dispEntry := close
    if buyTrig
        dispSL  := buySL
        dispTP  := buyTarget
        dispRR  := rrBuy
        dispDir := "BUY"
    else
        dispSL  := sellSL
        dispTP  := sellTarget
        dispRR  := rrSell
        dispDir := "SELL"
else if hasPending
    dispType := "PENDING"
    bool pendIsBuy = pendBuyWk or pendBuyMo or pendBuyUnt
    if pendBuyMo
        dispEntry := moVAL
    else if pendBuyWk
        dispEntry := wkVAL
    else if pendBuyUnt
        dispEntry := nearUntSupPrice
    else if pendSellMo
        dispEntry := moVAH
    else if pendSellWk
        dispEntry := wkVAH
    else if pendSellUnt
        dispEntry := nearUntResPrice
    dispDir := pendIsBuy ? "BUY" : "SELL"
    if not na(dispEntry) and atrV > 0
        if pendIsBuy
            float pSD = math.max(atrV * minStopATR, dispEntry - swingLow20 + atrV * atrBuf)
            dispSL := dispEntry - pSD
            dispTP := not na(wkVAH) ? wkVAH : not na(moVAH) ? moVAH : dispEntry + pSD * rrMin
            dispRR := pSD > 0 ? (dispTP - dispEntry) / pSD : 0.0
        else
            float pSD = math.max(atrV * minStopATR, swingHigh20 + atrV * atrBuf - dispEntry)
            dispSL := dispEntry + pSD
            dispTP := not na(wkVAL) ? wkVAL : not na(moVAL) ? moVAL : dispEntry - pSD * rrMin
            dispRR := pSD > 0 ? (dispEntry - dispTP) / pSD : 0.0
else if hasActiveTrade
    dispType := "ACTIVE"
    dispEntry := activeEntryPrice
    dispSL := activeSL
    dispTP := activeTP
    dispDir := activeIsBuy ? "BUY" : "SELL"
    if not na(dispEntry) and not na(dispSL)
        float sDist = math.abs(dispEntry - dispSL)
        float tDist = not na(dispTP) ? math.abs(dispTP - dispEntry) : 0.0
        dispRR := sDist > 0 ? tDist / sDist : 0.0

color dispTypeCol = dispType == "MARKET" ? color.new(#00E676, 0) : dispType == "PENDING" ? color.new(#2979FF, 0) : dispType == "ACTIVE" ? color.new(#FFC107, 0) : color.gray

// ══════════════════════════════════════════════════════════
//  PLOTS
// ══════════════════════════════════════════════════════════

// VP levels
plot(showWk ? wkPOC : na, "Wk POC", color.new(#FF9800, 30), 1, plot.style_stepline)
plot(showWk ? wkVAH : na, "Wk VAH", color.new(#EF5350, 30), 1, plot.style_stepline)
plot(showWk ? wkVAL : na, "Wk VAL", color.new(#26A69A, 30), 1, plot.style_stepline)
plot(showMo ? moPOC : na, "Mo POC", color.new(#FF9800, 0), 2, plot.style_stepline)
plot(showMo ? moVAH : na, "Mo VAH", color.new(#EF5350, 0), 2, plot.style_stepline)
plot(showMo ? moVAL : na, "Mo VAL", color.new(#26A69A, 0), 2, plot.style_stepline)

// ── Buy/Sell Zone Highlights (shaded VP proximity zones) ──
var box zBuyMo  = na
var box zSellMo = na
var box zBuyWk  = na
var box zSellWk = na

if barstate.islast and showVP
    box.delete(zBuyMo)
    box.delete(zSellMo)
    box.delete(zBuyWk)
    box.delete(zSellWk)
    float zoneATR = atrV * proxATR
    if showMo and not na(moVAL)
        zBuyMo := box.new(bar_index - 40, moVAL + zoneATR, bar_index + 2, moVAL - zoneATR, border_color=color.new(#00E676, 80), bgcolor=color.new(#00E676, 92))
    if showMo and not na(moVAH) and not buyOnly
        zSellMo := box.new(bar_index - 40, moVAH + zoneATR, bar_index + 2, moVAH - zoneATR, border_color=color.new(#FF1744, 80), bgcolor=color.new(#FF1744, 92))
    if showWk and not na(wkVAL)
        zBuyWk := box.new(bar_index - 40, wkVAL + zoneATR * 0.7, bar_index + 2, wkVAL - zoneATR * 0.7, border_color=color.new(#26A69A, 80), bgcolor=color.new(#26A69A, 93))
    if showWk and not na(wkVAH) and not buyOnly
        zSellWk := box.new(bar_index - 40, wkVAH + zoneATR * 0.7, bar_index + 2, wkVAH - zoneATR * 0.7, border_color=color.new(#EF5350, 80), bgcolor=color.new(#EF5350, 93))

// Market signals with entry price, SL, TP, R:R label
if buyTrig
    label.new(bar_index, low, "BUY @ " + str.tostring(close, format.mintick) + "\nSL " + str.tostring(buySL, format.mintick) + " | TP " + str.tostring(buyTarget, format.mintick) + "\nR:R " + str.tostring(rrBuy, "#.#"), xloc.bar_index, yloc.price, color.new(#00E676, 0), label.style_label_up, color.white, size.normal)
if sellTrig
    label.new(bar_index, high, "SELL @ " + str.tostring(close, format.mintick) + "\nSL " + str.tostring(sellSL, format.mintick) + " | TP " + str.tostring(sellTarget, format.mintick) + "\nR:R " + str.tostring(rrSell, "#.#"), xloc.bar_index, yloc.price, color.new(#FF1744, 0), label.style_label_down, color.white, size.normal)

// Active stop/target lines
plot(showSL and not na(activeSL) ? activeSL : na, "Active SL", color.new(#FF1744, 40), 1, plot.style_linebr)
plot(showSL and not na(activeTP) ? activeTP : na, "Active TP", color.new(#00E676, 40), 1, plot.style_linebr)

// Regime background
bgcolor(showBg ? (regime == "BULL" ? color.new(#00E676, 94) : regime == "BEAR" ? color.new(#FF1744, 94) : regime == "RANGE" ? color.new(#2979FF, 96) : na) : na, title="Regime Tint")

// ── Pending labels ──
var label lPBw = na
var label lPBm = na
var label lPSw = na
var label lPSm = na
var label lPBu = na
var label lPSu = na

if barstate.islast and showPnd
    label.delete(lPBw)
    label.delete(lPBm)
    label.delete(lPSw)
    label.delete(lPSm)
    label.delete(lPBu)
    label.delete(lPSu)

    if pendBuyWk
        lPBw := label.new(bar_index + 3, wkVAL, "PEND BUY (Wk)\n" + str.tostring(wkVAL, format.mintick), xloc.bar_index, yloc.price, color.new(#2979FF, 0), label.style_label_up, color.white, size.small)
    if pendBuyMo
        lPBm := label.new(bar_index + 8, moVAL, "PEND BUY (Mo)\n" + str.tostring(moVAL, format.mintick), xloc.bar_index, yloc.price, color.new(#1565C0, 0), label.style_label_up, color.white, size.small)
    if pendSellWk
        lPSw := label.new(bar_index + 3, wkVAH, "PEND SELL (Wk)\n" + str.tostring(wkVAH, format.mintick), xloc.bar_index, yloc.price, color.new(#AA00FF, 0), label.style_label_down, color.white, size.small)
    if pendSellMo
        lPSm := label.new(bar_index + 8, moVAH, "PEND SELL (Mo)\n" + str.tostring(moVAH, format.mintick), xloc.bar_index, yloc.price, color.new(#7B1FA2, 0), label.style_label_down, color.white, size.small)
    if pendBuyUnt and not na(nearUntSupPrice)
        lPBu := label.new(bar_index + 13, nearUntSupPrice, "PEND BUY (Unt)\n" + str.tostring(nearUntSupPrice, format.mintick), xloc.bar_index, yloc.price, color.new(#0D47A1, 0), label.style_label_up, color.white, size.small)
    if pendSellUnt and not na(nearUntResPrice)
        lPSu := label.new(bar_index + 13, nearUntResPrice, "PEND SELL (Unt)\n" + str.tostring(nearUntResPrice, format.mintick), xloc.bar_index, yloc.price, color.new(#4A148C, 0), label.style_label_down, color.white, size.small)

// ── Untested monthly VP levels ──
var line[] untVAHlines = array.new_line(0)
var line[] untVALlines = array.new_line(0)
var line[] untPOClines = array.new_line(0)

if barstate.islast and showUnt
    if array.size(untVAHlines) > 0
        for i = 0 to array.size(untVAHlines) - 1
            line.delete(array.get(untVAHlines, i))
    array.clear(untVAHlines)
    if array.size(untVALlines) > 0
        for i = 0 to array.size(untVALlines) - 1
            line.delete(array.get(untVALlines, i))
    array.clear(untVALlines)
    if array.size(untPOClines) > 0
        for i = 0 to array.size(untPOClines) - 1
            line.delete(array.get(untPOClines, i))
    array.clear(untPOClines)

    if array.size(untVAH) > 0
        for i = 0 to array.size(untVAH) - 1
            array.push(untVAHlines, line.new(bar_index - 20, array.get(untVAH, i), bar_index, array.get(untVAH, i), xloc.bar_index, extend.right, color.new(#FF1744, 50), line.style_dashed, 1))
    if array.size(untVAL) > 0
        for i = 0 to array.size(untVAL) - 1
            array.push(untVALlines, line.new(bar_index - 20, array.get(untVAL, i), bar_index, array.get(untVAL, i), xloc.bar_index, extend.right, color.new(#00E676, 50), line.style_dashed, 1))
    if array.size(untPOC) > 0
        for i = 0 to array.size(untPOC) - 1
            array.push(untPOClines, line.new(bar_index - 20, array.get(untPOC, i), bar_index, array.get(untPOC, i), xloc.bar_index, extend.right, color.new(#FFC107, 50), line.style_dashed, 1))

// ── VP Histogram Bars (boxes) ──
var box[] vpBoxes = array.new_box(0)

if barstate.islast and showVP
    if array.size(vpBoxes) > 0
        for i = 0 to array.size(vpBoxes) - 1
            box.delete(array.get(vpBoxes, i))
    array.clear(vpBoxes)
    int dRows = 24
    if showMo and not na(moHi) and not na(moLo) and moHi > moLo
        float moDBS = (moHi - moLo) / dRows
        float moMaxDV = 0.0
        for d = 0 to dRows - 1
            float tv = 0.0
            int s = int(d * vpRows / dRows)
            int e = int((d + 1) * vpRows / dRows) - 1
            for j = math.max(0, s) to math.min(vpRows - 1, e)
                tv += array.get(moBins, j)
            if tv > moMaxDV
                moMaxDV := tv
        if moMaxDV > 0
            for d = 0 to dRows - 1
                float vu = 0.0
                float vdn = 0.0
                int s = int(d * vpRows / dRows)
                int e = int((d + 1) * vpRows / dRows) - 1
                for j = math.max(0, s) to math.min(vpRows - 1, e)
                    vu += array.get(moBinsUp, j)
                    vdn += array.get(moBinsDn, j)
                float tv = vu + vdn
                if tv > 0
                    float rowLo = moLo + d * moDBS
                    float rowHi = rowLo + moDBS
                    int totalW = math.max(1, int(math.round(tv / moMaxDV * vpBarW)))
                    int upW = math.max(1, int(math.round(vu / tv * totalW)))
                    int dnW = math.max(1, totalW - upW)
                    int x1 = bar_index + 3
                    if vu > 0
                        array.push(vpBoxes, box.new(x1, rowHi, x1 + upW, rowLo, border_color=na, bgcolor=color.new(#26A69A, 40)))
                    if vdn > 0
                        int dnStart = vu > 0 ? x1 + upW : x1
                        array.push(vpBoxes, box.new(dnStart, rowHi, dnStart + dnW, rowLo, border_color=na, bgcolor=color.new(#EF5350, 40)))

// ══════════════════════════════════════════════════════════
//  DASHBOARD TABLE
// ══════════════════════════════════════════════════════════

tablePosition = tblPos == "Top Left" ? position.top_left : tblPos == "Bottom Right" ? position.bottom_right : tblPos == "Bottom Left" ? position.bottom_left : position.top_right

var table tbl = showTbl ? table.new(tablePosition, 5, 26, color.new(#0d1117, 5), color.new(#30363d, 0), 1, color.new(#30363d, 0), 1) : na

if showTbl and barstate.islast and not na(tbl)
    hBg = color.new(#161b22, 0)
    hFg = color.white
    dFg = color.new(#e6edf3, 0)
    mFg = color.new(#8b949e, 0)

    // Row 0 — header
    table.cell(tbl, 0, 0, "F98", text_color=hFg, text_size=size.small, bgcolor=hBg, text_halign=text.align_left)
    table.cell(tbl, 1, 0, "V2", text_color=color.new(#FFC107, 0), text_size=size.small, bgcolor=hBg, text_halign=text.align_center)
    table.cell(tbl, 2, 0, stratMode == "AUTO" ? regime : stratMode, text_color=regimeCol, text_size=size.small, bgcolor=hBg, text_halign=text.align_center)
    table.cell(tbl, 3, 0, buyOnly ? "BUY ONLY" : "BUY+SELL", text_color=buyOnly ? color.new(#00E676, 0) : color.new(#FFC107, 0), text_size=size.small, bgcolor=hBg, text_halign=text.align_center)
    table.cell(tbl, 4, 0, "", text_size=size.small, bgcolor=hBg)

    // Row 1 — Regime
    table.cell(tbl, 0, 1, "Regime", text_color=mFg, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 1, regime, text_color=regimeCol, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 1, "Bull:" + str.tostring(bullScore, "#"), text_color=mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 1, "ADX:" + str.tostring(adxV, "#"), text_color=mFg, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 4, 1, "", text_size=size.small)

    // Row 2 — Oscillators
    table.cell(tbl, 0, 2, "Oscillators", text_color=mFg, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 2, oscR, text_color=ratingCol(oscR), text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 2, str.tostring(oscBuy) + "B " + str.tostring(oscNeut) + "N " + str.tostring(oscSell) + "S", text_color=mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 2, "", text_size=size.small)
    table.cell(tbl, 4, 2, "", text_size=size.small)

    // Row 3 — Moving Averages
    table.cell(tbl, 0, 3, "Moving Avg", text_color=mFg, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 3, maR, text_color=ratingCol(maR), text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 3, str.tostring(maBuy) + "B " + str.tostring(maNeut) + "N " + str.tostring(maSell) + "S", text_color=mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 3, "", text_size=size.small)
    table.cell(tbl, 4, 3, "", text_size=size.small)

    // Row 4 — Summary
    table.cell(tbl, 0, 4, "SUMMARY", text_color=hFg, text_size=size.small, bgcolor=hBg, text_halign=text.align_left)
    table.cell(tbl, 1, 4, totR, text_color=ratingCol(totR), text_size=size.small, bgcolor=hBg, text_halign=text.align_center)
    table.cell(tbl, 2, 4, str.tostring(score, "#.##"), text_color=ratingCol(totR), text_size=size.small, bgcolor=hBg, text_halign=text.align_center)
    table.cell(tbl, 3, 4, "", text_size=size.small, bgcolor=hBg)
    table.cell(tbl, 4, 4, "", text_size=size.small, bgcolor=hBg)

    // Row 5 — Quality Score
    float activeQual = buyTrig ? qualBuy : sellTrig ? qualSell : math.max(qualityCalc("BUY", regime, nearestSup), qualityCalc("SELL", regime, nearestRes))
    color qCol = activeQual >= 75 ? color.new(#00E676, 0) : activeQual >= 65 ? color.new(#26A69A, 0) : activeQual >= 50 ? color.new(#FFC107, 0) : color.new(#EF5350, 0)
    table.cell(tbl, 0, 5, "Quality", text_color=mFg, text_size=size.small, text_halign=text.align_left)
    float activeAdjMin = buyTrig or nearSup ? adjMinQualBuy : sellTrig or nearRes ? adjMinQualSell : minQuality
    table.cell(tbl, 1, 5, str.tostring(activeQual, "#") + "/100", text_color=qCol, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 5, "Min:" + str.tostring(activeAdjMin, "#") + (activeAdjMin < minQuality ? "*" : ""), text_color=activeAdjMin < minQuality ? color.new(#FFC107, 0) : mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 5, activeQual >= activeAdjMin ? "PASS" : "FAIL", text_color=activeQual >= activeAdjMin ? color.new(#00E676, 0) : color.new(#FF1744, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 4, 5, "", text_size=size.small)

    // Row 6 — R:R
    float activeRR = buyTrig or nearSup ? rrBuy : sellTrig or nearRes ? rrSell : 0.0
    color rrCol = activeRR >= 2.5 ? color.new(#00E676, 0) : activeRR >= 2.0 ? color.new(#26A69A, 0) : activeRR >= 1.5 ? color.new(#FFC107, 0) : color.new(#EF5350, 0)
    table.cell(tbl, 0, 6, "R:R", text_color=mFg, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 6, str.tostring(activeRR, "#.#") + "R", text_color=rrCol, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 6, "Min:" + str.tostring(rrMin, "#.#"), text_color=mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 6, activeRR >= rrMin ? "PASS" : "FAIL", text_color=activeRR >= rrMin ? color.new(#00E676, 0) : color.new(#FF1744, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 4, 6, "", text_size=size.small)

    // Row 7 — V11 Conditions
    table.cell(tbl, 0, 7, "V11 Check", text_color=color.new(#FFC107, 0), text_size=size.small, bgcolor=hBg, text_halign=text.align_left)
    string v11Status = ""
    if oscOversold
        v11Status += "OS "
    if oscOverbought
        v11Status += "OB "
    if nearSup
        v11Status += "SUP "
    if nearRes
        v11Status += "RES "
    if nearPOC
        v11Status += "POC "
    if momBullish
        v11Status += "M+ "
    if momBearish
        v11Status += "M- "
    if bullPattern
        v11Status += "PAT "
    if vpConfBuy or vpConfSell
        v11Status += "CONF "
    if v11Status == ""
        v11Status := "---"
    table.cell(tbl, 1, 7, v11Status, text_color=v11_buy or v11_sell ? (v11_buy ? color.new(#00E676, 0) : color.new(#FF1744, 0)) : mFg, text_size=size.small, bgcolor=hBg, text_halign=text.align_center)
    table.cell(tbl, 2, 7, "RSI:" + str.tostring(rsiV, "#") + " K:" + str.tostring(rawK, "#"), text_color=mFg, text_size=size.small, bgcolor=hBg, text_halign=text.align_center)
    table.cell(tbl, 3, 7, "WR:" + str.tostring(wrV, "#"), text_color=mFg, text_size=size.small, bgcolor=hBg, text_halign=text.align_left)
    table.cell(tbl, 4, 7, "", text_size=size.small, bgcolor=hBg)

    // Row 8 — Vetoes
    string vetoText = vetoTransition ? "TRANSITION" : vetoATR ? "ATR" : vetoBuyOnly ? "BUY_ONLY" : vetoBullSell ? "BULL_SELL" : vetoCounterRegime ? "COUNTER_REGIME" : "NONE"
    table.cell(tbl, 0, 8, "Vetoes", text_color=mFg, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 8, vetoText, text_color=vetoed ? color.new(#FF1744, 0) : color.new(#00E676, 0), text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 8, "", text_size=size.small)
    table.cell(tbl, 3, 8, "", text_size=size.small)
    table.cell(tbl, 4, 8, "", text_size=size.small)

    // Row 9 — Signal
    table.cell(tbl, 0, 9, "Signal", text_color=hFg, text_size=size.small, bgcolor=hBg, text_halign=text.align_left)
    table.cell(tbl, 1, 9, sigText, text_color=sigCol, text_size=size.small, bgcolor=hBg, text_halign=text.align_center)
    table.cell(tbl, 2, 9, "", text_size=size.small, bgcolor=hBg)
    table.cell(tbl, 3, 9, "", text_size=size.small, bgcolor=hBg)
    table.cell(tbl, 4, 9, "", text_size=size.small, bgcolor=hBg)

    // Rows 10-12 — Weekly VP
    table.cell(tbl, 0, 10, "Wk VAH", text_color=color.new(#EF5350, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 10, not na(wkVAH) ? str.tostring(wkVAH, format.mintick) : "—", text_color=dFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 10, str.tostring(distWkVAH, "#.#") + " ATR", text_color=nearWkVAH ? color.new(#FF9800, 0) : mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 10, nearWkVAH ? "NEAR" : "", text_color=color.new(#FF9800, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 4, 10, "", text_size=size.small)

    table.cell(tbl, 0, 11, "Wk POC", text_color=color.new(#FF9800, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 11, not na(wkPOC) ? str.tostring(wkPOC, format.mintick) : "—", text_color=dFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 11, str.tostring(distWkPOC, "#.#") + " ATR", text_color=nearWkPOC ? color.new(#FF9800, 0) : mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 11, "", text_size=size.small)
    table.cell(tbl, 4, 11, "", text_size=size.small)

    table.cell(tbl, 0, 12, "Wk VAL", text_color=color.new(#26A69A, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 12, not na(wkVAL) ? str.tostring(wkVAL, format.mintick) : "—", text_color=dFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 12, str.tostring(distWkVAL, "#.#") + " ATR", text_color=nearWkVAL ? color.new(#FF9800, 0) : mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 12, nearWkVAL ? "NEAR" : "", text_color=color.new(#FF9800, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 4, 12, "", text_size=size.small)

    // Rows 13-15 — Monthly VP
    table.cell(tbl, 0, 13, "Mo VAH", text_color=color.new(#EF5350, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 13, not na(moVAH) ? str.tostring(moVAH, format.mintick) : "—", text_color=dFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 13, str.tostring(distMoVAH, "#.#") + " ATR", text_color=nearMoVAH ? color.new(#FF9800, 0) : mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 13, nearMoVAH ? "NEAR" : "", text_color=color.new(#FF9800, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 4, 13, "", text_size=size.small)

    table.cell(tbl, 0, 14, "Mo POC", text_color=color.new(#FF9800, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 14, not na(moPOC) ? str.tostring(moPOC, format.mintick) : "—", text_color=dFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 14, str.tostring(distMoPOC, "#.#") + " ATR", text_color=nearMoPOC ? color.new(#FF9800, 0) : mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 14, "", text_size=size.small)
    table.cell(tbl, 4, 14, "", text_size=size.small)

    table.cell(tbl, 0, 15, "Mo VAL", text_color=color.new(#26A69A, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 15, not na(moVAL) ? str.tostring(moVAL, format.mintick) : "—", text_color=dFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 15, str.tostring(distMoVAL, "#.#") + " ATR", text_color=nearMoVAL ? color.new(#FF9800, 0) : mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 15, nearMoVAL ? "NEAR" : "", text_color=color.new(#FF9800, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 4, 15, "", text_size=size.small)

    // Row 16 — spacer
    for c = 0 to 4
        table.cell(tbl, c, 16, "", text_size=size.tiny)

    // Row 17 — Order Section Header
    table.cell(tbl, 0, 17, "ORDER", text_color=hFg, text_size=size.small, bgcolor=hBg, text_halign=text.align_left)
    table.cell(tbl, 1, 17, dispType, text_color=dispTypeCol, text_size=size.small, bgcolor=hBg, text_halign=text.align_center)
    table.cell(tbl, 2, 17, dispDir, text_color=dispDir == "BUY" ? color.new(#00E676, 0) : dispDir == "SELL" ? color.new(#FF1744, 0) : mFg, text_size=size.small, bgcolor=hBg, text_halign=text.align_center)
    table.cell(tbl, 3, 17, strength, text_color=strength == "STRONG" ? color.new(#FFC107, 0) : mFg, text_size=size.small, bgcolor=hBg, text_halign=text.align_center)
    table.cell(tbl, 4, 17, "", text_size=size.small, bgcolor=hBg)

    // Row 18 — Pending Order
    bool pendYes = dispType == "PENDING"
    float pendATRaway = pendYes and not na(dispEntry) and atrV > 0 ? math.abs(close - dispEntry) / atrV : na
    table.cell(tbl, 0, 18, "Pending", text_color=mFg, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 18, pendYes ? "YES" : "NO", text_color=pendYes ? color.new(#2979FF, 0) : mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 18, pendYes and not na(dispEntry) ? "@ " + str.tostring(dispEntry, format.mintick) : "—", text_color=pendYes ? color.new(#2979FF, 0) : mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 18, not na(pendATRaway) ? str.tostring(pendATRaway, "#.#") + " ATR away" : "", text_color=mFg, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 4, 18, "", text_size=size.small)

    // Row 19 — Market Price (always current close)
    table.cell(tbl, 0, 19, "Market", text_color=mFg, text_size=size.small, text_halign=text.align_left)
    bool mktYes = dispType == "MARKET" or dispType == "ACTIVE"
    table.cell(tbl, 1, 19, mktYes ? "YES" : "NO", text_color=mktYes ? color.new(#00E676, 0) : mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 19, "@ " + str.tostring(close, format.mintick), text_color=dFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 19, "", text_size=size.small)
    table.cell(tbl, 4, 19, "", text_size=size.small)

    // Row 20 — Entry (active trade entry price + P/L)
    float activePL = not na(activeEntryPrice) ? (activeIsBuy ? close - activeEntryPrice : activeEntryPrice - close) : na
    table.cell(tbl, 0, 20, "Entry", text_color=mFg, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 20, not na(activeEntryPrice) ? str.tostring(activeEntryPrice, format.mintick) : "—", text_color=not na(activeEntryPrice) ? color.new(#FFC107, 0) : mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 20, not na(activePL) ? (activePL >= 0 ? "+" : "") + str.tostring(activePL / syminfo.mintick, "#") + " pips" : "—", text_color=not na(activePL) ? (activePL >= 0 ? color.new(#00E676, 0) : color.new(#FF1744, 0)) : mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 20, "", text_size=size.small)
    table.cell(tbl, 4, 20, "", text_size=size.small)

    // Row 21 — Stop Loss
    float slATRdist = not na(dispSL) and atrV > 0 ? math.abs(close - dispSL) / atrV : na
    table.cell(tbl, 0, 21, "Stop Loss", text_color=mFg, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 21, not na(dispSL) ? str.tostring(dispSL, format.mintick) : "—", text_color=not na(dispSL) ? color.new(#FF1744, 0) : mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 21, not na(slATRdist) ? str.tostring(slATRdist, "#.#") + " ATR" : "", text_color=mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 21, "", text_size=size.small)
    table.cell(tbl, 4, 21, "", text_size=size.small)

    // Row 22 — Take Profit
    table.cell(tbl, 0, 22, "Take Profit", text_color=mFg, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 22, not na(dispTP) ? str.tostring(dispTP, format.mintick) : "—", text_color=not na(dispTP) ? color.new(#00E676, 0) : mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 22, "", text_size=size.small)
    table.cell(tbl, 3, 22, "", text_size=size.small)
    table.cell(tbl, 4, 22, "", text_size=size.small)

    // Row 23 — Expected R:R
    color dispRRCol = not na(dispRR) and dispRR >= 2.5 ? color.new(#00E676, 0) : not na(dispRR) and dispRR >= 2.0 ? color.new(#26A69A, 0) : not na(dispRR) and dispRR >= 1.5 ? color.new(#FFC107, 0) : color.new(#EF5350, 0)
    table.cell(tbl, 0, 23, "Exp. R:R", text_color=mFg, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 23, not na(dispRR) ? str.tostring(dispRR, "#.#") + "R" : "—", text_color=not na(dispRR) ? dispRRCol : mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 23, not na(dispRR) ? (dispRR >= rrMin ? "PASS" : "FAIL") : "", text_color=not na(dispRR) ? (dispRR >= rrMin ? color.new(#00E676, 0) : color.new(#FF1744, 0)) : mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 23, "", text_size=size.small)
    table.cell(tbl, 4, 23, "", text_size=size.small)

    // Row 24 — Nearest Untested Support
    table.cell(tbl, 0, 24, "Unt Sup", text_color=mFg, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 24, not na(nearUntSupPrice) ? str.tostring(nearUntSupPrice, format.mintick) : "—", text_color=nearUntSup ? color.new(#00E676, 0) : mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 24, distUntSup < 999.0 ? str.tostring(distUntSup, "#.##") + " ATR" : "", text_color=nearUntSup ? color.new(#00E676, 0) : mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 24, array.size(untVAL) > 0 ? str.tostring(array.size(untVAL)) + " lvl" : "", text_color=mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 4, 24, "", text_size=size.small)

    // Row 25 — Nearest Untested Resistance
    table.cell(tbl, 0, 25, "Unt Res", text_color=mFg, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 25, not na(nearUntResPrice) ? str.tostring(nearUntResPrice, format.mintick) : "—", text_color=nearUntRes ? color.new(#FF1744, 0) : mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 25, distUntRes < 999.0 ? str.tostring(distUntRes, "#.##") + " ATR" : "", text_color=nearUntRes ? color.new(#FF1744, 0) : mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 25, array.size(untVAH) > 0 ? str.tostring(array.size(untVAH)) + " lvl" : "", text_color=mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 4, 25, "", text_size=size.small)

// ══════════════════════════════════════════════════════════
//  ALERTS
// ══════════════════════════════════════════════════════════

alertcondition(buyTrig,  "Market Buy",  "F98 V2 BUY at {{close}} — Quality passed | R:R passed")
alertcondition(sellTrig, "Market Sell", "F98 V2 SELL at {{close}} — Quality passed | R:R passed")
alertcondition(pendBuyWk  and not (pendBuyWk[1]  == true),  "Pending Buy (Wk)",  "Pending BUY zone — Weekly VAL {{close}}")
alertcondition(pendSellWk and not (pendSellWk[1] == true), "Pending Sell (Wk)", "Pending SELL zone — Weekly VAH {{close}}")
alertcondition(pendBuyMo  and not (pendBuyMo[1]  == true),  "Pending Buy (Mo)",  "Pending BUY zone — Monthly VAL {{close}}")
alertcondition(pendSellMo and not (pendSellMo[1] == true), "Pending Sell (Mo)", "Pending SELL zone — Monthly VAH {{close}}")
alertcondition(pendBuyUnt  and not (pendBuyUnt[1]  == true),  "Pending Buy (Unt)",  "Pending BUY zone — Untested VAL {{close}}")
alertcondition(pendSellUnt and not (pendSellUnt[1] == true), "Pending Sell (Unt)", "Pending SELL zone — Untested VAH {{close}}")
alertcondition(regime == "TRANSITION" and (na(regime[1]) or regime[1] != "TRANSITION"), "Regime Transition", "VETO: Market entered TRANSITION regime — no new entries")
alertcondition(not na(activeSL) and ((activeIsBuy and low <= activeSL) or (not activeIsBuy and high >= activeSL)), "Stop Hit", "Stop loss hit — exit position")
