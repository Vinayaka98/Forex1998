//@version=5
indicator("Forex1998 Blueprint V2 Order Indicator", "F98 V2", true, max_bars_back=5000, max_labels_count=200, max_lines_count=100)

// ══════════════════════════════════════════════════════════
//  INPUTS
// ══════════════════════════════════════════════════════════

// ── Volume Profile ──
g1      = "Volume Profile"
vpRows  = input.int(100, "Rows", minval=10, maxval=200, group=g1)
vpVA    = input.float(69, "Value Area %", minval=50, maxval=95, step=1, group=g1)
showWk  = input.bool(true, "Show Weekly Levels", group=g1)
showMo  = input.bool(true, "Show Monthly Levels", group=g1)

// ── Strategy ──
g2      = "Strategy Settings"
stratMode = input.string("V11: Hybrid", "Strategy Mode", options=["AUTO", "A: Trend Pullback", "B: Range Reversion", "V11: Hybrid"], group=g2, tooltip="V11 Hybrid (default) — backtested winner: 56% WR, PF 3.25, +43 pips/trade. AUTO combines A+B+V11 for more signals.")
proxATR = input.float(0.6, "VP Proximity (ATR)", minval=0.1, maxval=3.0, step=0.1, group=g2, tooltip="Optimized: 0.6 ATR. Moderate proximity catches more VP setups without diluting quality.")
minQuality = input.int(65, "Min Quality Score", minval=0, maxval=100, group=g2, tooltip="Optimized: 65. Moderate filter balances signal count vs quality. Blueprint was 70.")
rrMin   = input.float(2.0, "Min R:R Ratio", minval=0.0, maxval=5.0, step=0.1, group=g2, tooltip="Optimized: 2.0. Higher R:R ensures every trade has strong risk-adjusted edge.")
cdBars  = input.int(5, "Signal Cooldown (bars)", minval=1, maxval=50, group=g2, tooltip="Optimized: 5. Slightly faster re-entry than Blueprint's 6 for volatile pairs.")
atrBuf  = input.float(0.35, "Stop ATR Buffer", minval=0.0, maxval=1.0, step=0.05, group=g2, tooltip="Optimized: 0.35. Wider buffer for volatile/JPY pairs. Blueprint was 0.2.")
minStopATR = input.float(0.8, "Min Stop Distance (ATR)", minval=0.1, maxval=3.0, step=0.1, group=g2, tooltip="Minimum stop distance as ATR multiple. Prevents tight stops on volatile pairs.")
buyOnly = input.bool(true, "Buy Only Mode", group=g2, tooltip="When enabled, all sell signals are vetoed. Backtesting shows sells have 17-26% WR on volatile pairs — buy-only doubles net performance.")

// ── Exit ──
g2b     = "Exit Settings"
exitMode = input.string("Time_20bar", "Exit Model", options=["R2_Target", "R1.5_Target", "Struct_Trail", "Struct_Trail_BE", "Time_15bar", "Time_20bar"], group=g2b, tooltip="Time_20bar (default, backtested winner). Lets winners run full 20 bars — 92% WR on time exits, avg +77 pips.")
holdBars = input.int(20, "Time Exit Bars", minval=5, maxval=50, group=g2b, tooltip="Bars until time-based exit (if Time exit selected).")

// ── V11 Hybrid Oscillator Thresholds ──
g2c     = "V11 Hybrid (if selected)"
rsiOB   = input.int(65, "RSI Overbought", minval=55, maxval=80, group=g2c)
rsiOS   = input.int(35, "RSI Oversold", minval=20, maxval=45, group=g2c)

// ── Display ──
g3      = "Display"
showTbl = input.bool(true, "Show Dashboard", group=g3)
tblPos  = input.string("Top Right", "Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=g3)
showBg  = input.bool(true, "Regime Background Tint", group=g3)
showPnd = input.bool(true, "Pending-Order Labels", group=g3)
showSL  = input.bool(true, "Show Stop/Target Lines", group=g3)

// ══════════════════════════════════════════════════════════
//  VOLUME PROFILE — core calculation
// ══════════════════════════════════════════════════════════

vpCalc(float[] bins, float hi, float lo, float totV, int rows, float vaPct) =>
    float _poc = na
    float _vah = na
    float _val = na
    if hi > lo and totV > 0
        float bs = (hi - lo) / rows
        float mx = 0.0
        int   pi = 0
        for i = 0 to rows - 1
            float v = array.get(bins, i)
            if v > mx
                mx := v
                pi := i
        _poc := lo + (pi + 0.5) * bs
        float av = mx
        int   aH = pi
        int   aL = pi
        float tgt = totV * vaPct / 100.0
        for _j = 0 to rows
            if av >= tgt
                break
            float uv = aH < rows - 1 ? array.get(bins, aH + 1) : 0.0
            float dv = aL > 0       ? array.get(bins, aL - 1) : 0.0
            if (uv >= dv or aL <= 0) and aH < rows - 1
                aH += 1
                av += uv
            else if aL > 0
                aL -= 1
                av += dv
            else
                break
        _vah := lo + (aH + 1) * bs
        _val := lo + aL * bs
    [_poc, _vah, _val]

// ── Weekly VP ──
var float[] wkBins = array.new_float(vpRows, 0.0)
var float   wkHi   = na
var float   wkLo   = na
var float   wkVol  = 0.0

if ta.change(time("W"))
    array.fill(wkBins, 0.0)
    wkHi  := high
    wkLo  := low
    wkVol := 0.0
if na(wkHi)
    wkHi := high
    wkLo := low

wkHi := math.max(wkHi, high)
wkLo := math.min(wkLo, low)

if wkHi > wkLo
    float bs = (wkHi - wkLo) / vpRows
    int   ix = math.min(int(math.floor((hlc3 - wkLo) / bs)), vpRows - 1)
    if ix >= 0 and ix < vpRows
        array.set(wkBins, ix, array.get(wkBins, ix) + volume)
    wkVol += volume

[wkPOC, wkVAH, wkVAL] = vpCalc(wkBins, wkHi, wkLo, wkVol, vpRows, vpVA)

// ── Monthly VP ──
var float[] moBins = array.new_float(vpRows, 0.0)
var float   moHi   = na
var float   moLo   = na
var float   moVol  = 0.0

if ta.change(time("M"))
    array.fill(moBins, 0.0)
    moHi  := high
    moLo  := low
    moVol := 0.0
if na(moHi)
    moHi := high
    moLo := low

moHi := math.max(moHi, high)
moLo := math.min(moLo, low)

if moHi > moLo
    float bs = (moHi - moLo) / vpRows
    int   ix = math.min(int(math.floor((hlc3 - moLo) / bs)), vpRows - 1)
    if ix >= 0 and ix < vpRows
        array.set(moBins, ix, array.get(moBins, ix) + volume)
    moVol += volume

[moPOC, moVAH, moVAL] = vpCalc(moBins, moHi, moLo, moVol, vpRows, vpVA)

// ══════════════════════════════════════════════════════════
//  INDICATORS
// ══════════════════════════════════════════════════════════

// ATR
float atrV = ta.atr(14)

// ── 11 Oscillators (TradingView Technicals match) ──
float rsiV = ta.rsi(close, 14)
int   sRsi = rsiV < 30 ? 1 : rsiV > 70 ? -1 : 0

float rawK  = ta.sma(ta.stoch(close, high, low, 14), 3)
float rawD  = ta.sma(rawK, 3)
int   sStch = rawK < 20 ? 1 : rawK > 80 ? -1 : 0

float cciV = ta.cci(close, 20)
int   sCci = cciV < -100 ? 1 : cciV > 100 ? -1 : 0

[dip, dim, adxV] = ta.dmi(14, 14)
int sAdx = adxV > 20 and dip > dim ? 1 : adxV > 20 and dim > dip ? -1 : 0

float aoV = ta.sma(hl2, 5) - ta.sma(hl2, 34)
int   sAo = aoV > 0 ? 1 : aoV < 0 ? -1 : 0

float momV = ta.mom(close, 10)
int   sMom = momV > 0 ? 1 : momV < 0 ? -1 : 0

[macdL, sigL, _hist] = ta.macd(close, 12, 26, 9)
int sMacd = macdL > sigL ? 1 : macdL < sigL ? -1 : 0

float srRaw = ta.sma(ta.stoch(ta.rsi(close, 14), ta.rsi(close, 14), ta.rsi(close, 14), 14), 3)
float srD   = ta.sma(srRaw, 3)
int   sSrsi = srRaw < 20 ? 1 : srRaw > 80 ? -1 : 0

float wrV = ta.wpr(14)
int   sWr = wrV < -80 ? 1 : wrV > -20 ? -1 : 0

float bbpV = (high - ta.ema(close, 13)) + (low - ta.ema(close, 13))
int   sBbp = bbpV > 0 ? 1 : bbpV < 0 ? -1 : 0

float bp  = close - math.min(low, nz(close[1], low))
float tr  = math.max(high, nz(close[1], high)) - math.min(low, nz(close[1], low))
float uoV = 100.0 * (4.0 * math.sum(bp, 7) / math.sum(tr, 7) + 2.0 * math.sum(bp, 14) / math.sum(tr, 14) + math.sum(bp, 28) / math.sum(tr, 28)) / 7.0
int   sUo = uoV < 30 ? 1 : uoV > 70 ? -1 : 0

int oscBuy  = (sRsi==1?1:0)+(sStch==1?1:0)+(sCci==1?1:0)+(sAdx==1?1:0)+(sAo==1?1:0)+(sMom==1?1:0)+(sMacd==1?1:0)+(sSrsi==1?1:0)+(sWr==1?1:0)+(sBbp==1?1:0)+(sUo==1?1:0)
int oscSell = (sRsi==-1?1:0)+(sStch==-1?1:0)+(sCci==-1?1:0)+(sAdx==-1?1:0)+(sAo==-1?1:0)+(sMom==-1?1:0)+(sMacd==-1?1:0)+(sSrsi==-1?1:0)+(sWr==-1?1:0)+(sBbp==-1?1:0)+(sUo==-1?1:0)
int oscNeut = 11 - oscBuy - oscSell
float oscScore = (oscBuy - oscSell) / 11.0

// ── 15 Moving Averages (TradingView Technicals match) ──
float e10  = ta.ema(close, 10)
float s10  = ta.sma(close, 10)
float e20  = ta.ema(close, 20)
float s20  = ta.sma(close, 20)
float e30  = ta.ema(close, 30)
float s30  = ta.sma(close, 30)
float e50  = ta.ema(close, 50)
float s50  = ta.sma(close, 50)
float e100 = ta.ema(close, 100)
float s100 = ta.sma(close, 100)
float e200 = ta.ema(close, 200)
float s200 = ta.sma(close, 200)
float ich  = (ta.highest(high, 26) + ta.lowest(low, 26)) / 2.0
float vw20 = ta.vwma(close, 20)
float hma9 = ta.wma(2.0 * ta.wma(close, int(math.round(9.0 / 2.0))) - ta.wma(close, 9), int(math.round(math.sqrt(9.0))))

int maBuy  = 0
int maSell = 0
maBuy  += close > e10  ? 1 : 0
maSell += close < e10  ? 1 : 0
maBuy  += close > s10  ? 1 : 0
maSell += close < s10  ? 1 : 0
maBuy  += close > e20  ? 1 : 0
maSell += close < e20  ? 1 : 0
maBuy  += close > s20  ? 1 : 0
maSell += close < s20  ? 1 : 0
maBuy  += close > e30  ? 1 : 0
maSell += close < e30  ? 1 : 0
maBuy  += close > s30  ? 1 : 0
maSell += close < s30  ? 1 : 0
maBuy  += close > e50  ? 1 : 0
maSell += close < e50  ? 1 : 0
maBuy  += close > s50  ? 1 : 0
maSell += close < s50  ? 1 : 0
maBuy  += close > e100 ? 1 : 0
maSell += close < e100 ? 1 : 0
maBuy  += close > s100 ? 1 : 0
maSell += close < s100 ? 1 : 0
maBuy  += close > e200 ? 1 : 0
maSell += close < e200 ? 1 : 0
maBuy  += close > s200 ? 1 : 0
maSell += close < s200 ? 1 : 0
maBuy  += close > ich  ? 1 : 0
maSell += close < ich  ? 1 : 0
maBuy  += close > vw20 ? 1 : 0
maSell += close < vw20 ? 1 : 0
maBuy  += close > hma9 ? 1 : 0
maSell += close < hma9 ? 1 : 0

int   maNeut  = 15 - maBuy - maSell
float maScore = (maBuy - maSell) / 15.0
float score   = (oscScore + maScore) / 2.0

rating(float s) =>
    s > 0.5 ? "STRONG BUY" : s > 0.1 ? "BUY" : s < -0.5 ? "STRONG SELL" : s < -0.1 ? "SELL" : "NEUTRAL"

ratingCol(string r) =>
    switch r
        "STRONG BUY"  => color.new(#00E676, 0)
        "BUY"         => color.new(#26A69A, 0)
        "SELL"        => color.new(#EF5350, 0)
        "STRONG SELL" => color.new(#FF1744, 0)
        => color.new(#78909C, 0)

string oscR = rating(oscScore)
string maR  = rating(maScore)
string totR = rating(score)

// ══════════════════════════════════════════════════════════
//  MARKET REGIME ENGINE (Blueprint Section 5)
//  Weighted bull score: Mo POC 25%, Wk POC 15%, 200 EMA 15%,
//  50>200 EMA 15%, 50 EMA slope 10%, ADX 10%, HH/HL 10%
// ══════════════════════════════════════════════════════════

float bullScore = 0.0
bullScore += not na(moPOC) and close > moPOC ? 25.0 : 0.0
bullScore += not na(wkPOC) and close > wkPOC ? 15.0 : 0.0
bullScore += not na(e200) and close > e200 ? 15.0 : 0.0
bullScore += not na(e50) and not na(e200) and e50 > e200 ? 15.0 : 0.0

float ema50Slope = not na(e50[5]) ? (e50 - e50[5]) / nz(e50[5], 1) * 100 : 0.0
bullScore += ema50Slope > 0.05 ? 10.0 : 0.0
bullScore += adxV > 25 ? 10.0 : 0.0

int hhCount = 0
int hlCount = 0
for k = 2 to 20
    if high[k] > high[k + 2]
        hhCount += 1
    if low[k] > low[k + 2]
        hlCount += 1
bullScore += hhCount > 7 and hlCount > 7 ? 10.0 : 0.0

bool adxTrending = adxV > 20

string regime = "TRANSITION"
if bullScore >= 60 and adxTrending
    regime := "BULL"
else if bullScore <= 30 and adxTrending
    regime := "BEAR"
else if not adxTrending or (bullScore > 35 and bullScore < 55)
    regime := "RANGE"

color regimeCol = switch regime
    "BULL"       => color.new(#00E676, 0)
    "BEAR"       => color.new(#FF1744, 0)
    "RANGE"      => color.new(#2979FF, 0)
    "TRANSITION" => color.new(#FFC107, 0)
    => color.gray

// ══════════════════════════════════════════════════════════
//  ATR-NORMALIZED VP PROXIMITY (Blueprint Section 6)
//  DistanceRatio = abs(Price - VP_Level) / ATR
// ══════════════════════════════════════════════════════════

float distWkVAL = not na(wkVAL) and atrV > 0 ? math.abs(close - wkVAL) / atrV : 999.0
float distWkVAH = not na(wkVAH) and atrV > 0 ? math.abs(close - wkVAH) / atrV : 999.0
float distWkPOC = not na(wkPOC) and atrV > 0 ? math.abs(close - wkPOC) / atrV : 999.0
float distMoVAL = not na(moVAL) and atrV > 0 ? math.abs(close - moVAL) / atrV : 999.0
float distMoVAH = not na(moVAH) and atrV > 0 ? math.abs(close - moVAH) / atrV : 999.0
float distMoPOC = not na(moPOC) and atrV > 0 ? math.abs(close - moPOC) / atrV : 999.0

bool nearWkVAL = distWkVAL <= proxATR
bool nearWkVAH = distWkVAH <= proxATR
bool nearWkPOC = distWkPOC <= proxATR
bool nearMoVAL = distMoVAL <= proxATR
bool nearMoVAH = distMoVAH <= proxATR
bool nearMoPOC = distMoPOC <= proxATR

bool nearSup = nearWkVAL or nearMoVAL
bool nearRes = nearWkVAH or nearMoVAH
bool nearPOC = nearWkPOC or nearMoPOC

float nearestSup = math.min(distWkVAL, distMoVAL)
float nearestRes = math.min(distWkVAH, distMoVAH)
float nearestVP  = math.min(math.min(distWkVAL, distWkVAH), math.min(distMoVAL, distMoVAH))

// ══════════════════════════════════════════════════════════
//  WEIGHTED QUALITY SCORE (Blueprint Section 8.1)
//  Regime 25, HT Direction 20, VP Location 20,
//  Price Confirm 15, Momentum 10, Volatility 5, Oscillators 5
// ══════════════════════════════════════════════════════════

qualityCalc(string dir, string reg, float vpDist) =>
    float q = 0.0
    // Regime alignment (25 pts)
    q += (reg == "BULL" and dir == "BUY") or (reg == "BEAR" and dir == "SELL") ? 25.0 : reg == "RANGE" ? 15.0 : 0.0
    // Higher TF direction (20 pts)
    if dir == "BUY"
        q += close > e200 ? 20.0 : not na(e200) and math.abs(close - e200) / nz(atrV, 1) < 1 ? 10.0 : 0.0
    else
        q += close < e200 ? 20.0 : not na(e200) and math.abs(close - e200) / nz(atrV, 1) < 1 ? 10.0 : 0.0
    // VP location (20 pts)
    q += vpDist < 0.3 ? 20.0 : vpDist < 0.5 ? 15.0 : vpDist < 1.0 ? 10.0 : 0.0
    // Price confirmation (15 pts)
    q += (dir == "BUY" and close > open) or (dir == "SELL" and close < open) ? 15.0 : 7.0
    // Momentum (10 pts)
    q += (rsiV > 30 and rsiV < 70) ? 10.0 : (dir == "BUY" and rsiV < 30) or (dir == "SELL" and rsiV > 70) ? 5.0 : 0.0
    // Volatility (5 pts)
    float atrAvg = ta.sma(atrV, 20)
    q += not na(atrAvg) and atrAvg > 0 and atrV / atrAvg > 0.5 and atrV / atrAvg < 1.5 ? 5.0 : 0.0
    // Oscillators (5 pts)
    q += (dir == "BUY" and rawK < 30) or (dir == "SELL" and rawK > 70) ? 5.0 : (rawK >= 30 and rawK <= 70) ? 2.0 : 0.0
    q

// ══════════════════════════════════════════════════════════
//  STRUCTURAL STOPS (Blueprint Section 9.2)
//  Buy: swing low - ATR buffer
//  Sell: swing high + ATR buffer
// ══════════════════════════════════════════════════════════

float swingLow10  = ta.lowest(low, 10)
float swingHigh10 = ta.highest(high, 10)

float buySL  = swingLow10 - atrV * atrBuf
float sellSL = swingHigh10 + atrV * atrBuf

float buyStopDist  = close - buySL
float sellStopDist = sellSL - close

float minStopDist = atrV * minStopATR
if buyStopDist < minStopDist
    buySL := close - minStopDist
    buyStopDist := minStopDist
if sellStopDist < minStopDist
    sellSL := close + minStopDist
    sellStopDist := minStopDist

// ══════════════════════════════════════════════════════════
//  SIGNAL GENERATION (Blueprint Strategies A, B, V11)
// ══════════════════════════════════════════════════════════

// ── Strategy A: Trend Pullback (S7.1) ──
bool stratA_buy  = regime == "BULL" and (nearSup or nearPOC) and close >= nz(wkVAL, close)
bool stratA_sell = regime == "BEAR" and (nearRes or nearPOC) and close <= nz(wkVAH, close)

// ── Strategy B: Range Reversion (S7.2) ──
bool stratB_buy  = regime == "RANGE" and nearSup and close >= nz(math.min(nz(wkVAL, close), nz(moVAL, close)), close)
bool stratB_sell = regime == "RANGE" and nearRes and close <= nz(math.max(nz(wkVAH, close), nz(moVAH, close)), close)

// ── V11 Hybrid: Oscillator extreme + VP + momentum ──
bool oscOversold  = rsiV < rsiOS or rawK < 25 or wrV < -75
bool oscOverbought = rsiV > rsiOB or rawK > 75 or wrV > -25
float prevScore = nz(score[1], 0)
bool momBullish = score > prevScore
bool momBearish = score < prevScore
bool v11_buy  = oscOversold and nearSup and momBullish and regime != "BEAR"
bool v11_sell = oscOverbought and nearRes and momBearish and regime != "BULL"

// ── Select active strategy ──
bool rawBuy  = false
bool rawSell = false
string activeStrat = ""

if stratMode == "A: Trend Pullback"
    rawBuy  := stratA_buy
    rawSell := stratA_sell
    activeStrat := "A"
else if stratMode == "B: Range Reversion"
    rawBuy  := stratB_buy
    rawSell := stratB_sell
    activeStrat := "B"
else if stratMode == "V11: Hybrid"
    rawBuy  := v11_buy
    rawSell := v11_sell
    activeStrat := "V11"
else
    // AUTO: use A in trends, B in ranges, V11 as supplement
    if regime == "BULL"
        rawBuy  := stratA_buy or v11_buy
        activeStrat := stratA_buy ? "A" : "V11"
    else if regime == "BEAR"
        rawSell := stratA_sell or v11_sell
        activeStrat := stratA_sell ? "A" : "V11"
    else if regime == "RANGE"
        rawBuy  := stratB_buy or v11_buy
        rawSell := stratB_sell or v11_sell
        activeStrat := stratB_buy or stratB_sell ? "B" : "V11"

// ── Oscillator extremes (needed by vetoes and signal strength) ──
int oscExtBuy  = (rsiV < rsiOS ? 1 : 0) + (rawK < 25 ? 1 : 0) + (wrV < -75 ? 1 : 0)
int oscExtSell = (rsiV > rsiOB ? 1 : 0) + (rawK > 75 ? 1 : 0) + (wrV > -25 ? 1 : 0)
string strength = oscExtBuy >= 2 or oscExtSell >= 2 ? "STRONG" : "NORMAL"

// ── Hard Vetoes (Blueprint S8.3) ──
bool vetoTransition = regime == "TRANSITION"
bool vetoATR = na(atrV) or atrV < syminfo.mintick
bool vetoCounterRegime = (regime == "BULL" and rawSell) or (regime == "BEAR" and rawBuy)

// Bull-regime sell filter: sells in bull regime need quality >= 85 AND 2+ overbought oscillators
bool vetoBullSell = false
if regime == "BULL" and rawSell
    float sellQ = qualityCalc("SELL", regime, nearestRes)
    vetoBullSell := sellQ < 85 or oscExtSell < 2

bool vetoed = vetoTransition or vetoATR
if vetoCounterRegime and stratMode != "V11: Hybrid"
    vetoed := true
if vetoBullSell
    vetoed := true

bool vetoBuyOnly = buyOnly and rawSell
if vetoBuyOnly
    vetoed := true

// ── Quality Gate ──
float qualBuy  = rawBuy  ? qualityCalc("BUY", regime, nearestSup) : 0.0
float qualSell = rawSell ? qualityCalc("SELL", regime, nearestRes) : 0.0

bool qualPassBuy  = qualBuy >= minQuality
bool qualPassSell = qualSell >= minQuality

// ── R:R Gate (Blueprint S9.1) ──
float buyTarget  = na
float sellTarget = na

if exitMode == "R2_Target"
    buyTarget  := close + 2.0 * buyStopDist
    sellTarget := close - 2.0 * sellStopDist
else if exitMode == "R1.5_Target"
    buyTarget  := close + 1.5 * buyStopDist
    sellTarget := close - 1.5 * sellStopDist
else
    buyTarget  := nz(math.max(nz(wkVAH, close), nz(moVAH, close)), close + atrV)
    sellTarget := nz(math.min(nz(wkVAL, close), nz(moVAL, close)), close - atrV)

float rrBuy  = buyStopDist > 0 ? (buyTarget - close) / buyStopDist : 0.0
float rrSell = sellStopDist > 0 ? (close - sellTarget) / sellStopDist : 0.0

bool rrPassBuy  = rrBuy >= rrMin
bool rrPassSell = rrSell >= rrMin

// ── Final Signal (confirmed bars only — prevents repainting) ──
bool mktBuy  = rawBuy  and not vetoed and qualPassBuy  and rrPassBuy  and barstate.isconfirmed
bool mktSell = rawSell and not vetoed and qualPassSell and rrPassSell and barstate.isconfirmed

// ── Cooldown ──
var int lastBuyBar  = -9999
var int lastSellBar = -9999
bool buyTrig  = mktBuy  and (bar_index - lastBuyBar  >= cdBars)
bool sellTrig = mktSell and (bar_index - lastSellBar >= cdBars)
if buyTrig
    lastBuyBar := bar_index
if sellTrig
    lastSellBar := bar_index

// ── Active trade tracking ──
var float activeSL     = na
var float activeTP     = na
var bool  activeIsBuy  = false
var int   activeEntry  = na

if buyTrig
    activeSL    := buySL
    activeTP    := buyTarget
    activeIsBuy := true
    activeEntry := bar_index

if sellTrig
    activeSL    := sellSL
    activeTP    := sellTarget
    activeIsBuy := false
    activeEntry := bar_index

// Exit tracking
bool timeExit = false
if not na(activeEntry)
    int barsHeld = bar_index - activeEntry
    if exitMode == "Time_15bar" and barsHeld >= 15
        timeExit := true
    else if exitMode == "Time_20bar" and barsHeld >= holdBars
        timeExit := true

    if activeIsBuy
        if low <= activeSL or high >= activeTP or timeExit
            activeSL    := na
            activeTP    := na
            activeEntry := na
    else
        if high >= activeSL or low <= activeTP or timeExit
            activeSL    := na
            activeTP    := na
            activeEntry := na

    // Trailing stop update
    if (exitMode == "Struct_Trail" or exitMode == "Struct_Trail_BE") and not na(activeSL)
        if activeIsBuy
            float newSL = low - atrV * 0.3
            if newSL > activeSL
                activeSL := newSL
            if exitMode == "Struct_Trail_BE" and (high - close[nz(activeEntry, bar_index)]) > buyStopDist * 0.5
                if activeSL < close[nz(activeEntry, bar_index)]
                    activeSL := close[nz(activeEntry, bar_index)] + atrV * 0.05
        else
            float newSL = high + atrV * 0.3
            if newSL < activeSL
                activeSL := newSL
            if exitMode == "Struct_Trail_BE" and (close[nz(activeEntry, bar_index)] - low) > sellStopDist * 0.5
                if activeSL > close[nz(activeEntry, bar_index)]
                    activeSL := close[nz(activeEntry, bar_index)] - atrV * 0.05

// ── Pending Orders ──
bool oscApproachOS = rsiV < 45 or rawK < 35 or wrV < -55
bool oscApproachOB = rsiV > 55 or rawK > 65 or wrV > -45

bool pendBuyWk  = not na(wkVAL) and distWkVAL > proxATR and distWkVAL < proxATR * 3 and oscApproachOS and regime != "BEAR"
bool pendBuyMo  = not na(moVAL) and distMoVAL > proxATR and distMoVAL < proxATR * 3 and oscApproachOS and regime != "BEAR"
bool pendSellWk = not buyOnly and not na(wkVAH) and distWkVAH > proxATR and distWkVAH < proxATR * 3 and oscApproachOB and regime != "BULL"
bool pendSellMo = not buyOnly and not na(moVAH) and distMoVAH > proxATR and distMoVAH < proxATR * 3 and oscApproachOB and regime != "BULL"

// ── Signal Text ──
string sigText = "WAIT"
color  sigCol  = color.gray

if buyTrig
    sigText := "MKT BUY [" + activeStrat + "] Q:" + str.tostring(qualBuy, "#") + " R:" + str.tostring(rrBuy, "#.#")
    sigCol  := color.new(#00E676, 0)
else if sellTrig
    sigText := "MKT SELL [" + activeStrat + "] Q:" + str.tostring(qualSell, "#") + " R:" + str.tostring(rrSell, "#.#")
    sigCol  := color.new(#FF1744, 0)
else if pendBuyMo
    sigText := "PEND BUY @ " + str.tostring(moVAL, format.mintick)
    sigCol  := color.new(#2979FF, 0)
else if pendBuyWk
    sigText := "PEND BUY @ " + str.tostring(wkVAL, format.mintick)
    sigCol  := color.new(#2979FF, 0)
else if pendSellMo
    sigText := "PEND SELL @ " + str.tostring(moVAH, format.mintick)
    sigCol  := color.new(#AA00FF, 0)
else if pendSellWk
    sigText := "PEND SELL @ " + str.tostring(wkVAH, format.mintick)
    sigCol  := color.new(#AA00FF, 0)

// ══════════════════════════════════════════════════════════
//  PLOTS
// ══════════════════════════════════════════════════════════

// VP levels
plot(showWk ? wkPOC : na, "Wk POC", color.new(#FF9800, 30), 1, plot.style_stepline)
plot(showWk ? wkVAH : na, "Wk VAH", color.new(#EF5350, 30), 1, plot.style_stepline)
plot(showWk ? wkVAL : na, "Wk VAL", color.new(#26A69A, 30), 1, plot.style_stepline)
plot(showMo ? moPOC : na, "Mo POC", color.new(#FF9800, 0), 2, plot.style_stepline)
plot(showMo ? moVAH : na, "Mo VAH", color.new(#EF5350, 0), 2, plot.style_stepline)
plot(showMo ? moVAL : na, "Mo VAL", color.new(#26A69A, 0), 2, plot.style_stepline)

// Market signals with strategy label
plotshape(buyTrig,  "Market Buy",  shape.labelup,   location.belowbar, color.new(#00E676, 0), text="BUY",  textcolor=color.white, size=size.normal)
plotshape(sellTrig, "Market Sell", shape.labeldown,  location.abovebar, color.new(#FF1744, 0), text="SELL", textcolor=color.white, size=size.normal)

// Active stop/target lines
plot(showSL and not na(activeSL) ? activeSL : na, "Active SL", color.new(#FF1744, 40), 1, plot.style_linebr)
plot(showSL and not na(activeTP) ? activeTP : na, "Active TP", color.new(#00E676, 40), 1, plot.style_linebr)

// Regime background
bgcolor(showBg ? (regime == "BULL" ? color.new(#00E676, 94) : regime == "BEAR" ? color.new(#FF1744, 94) : regime == "RANGE" ? color.new(#2979FF, 96) : na) : na, title="Regime Tint")

// ── Pending labels ──
var label lPBw = na
var label lPBm = na
var label lPSw = na
var label lPSm = na

if barstate.islast and showPnd
    label.delete(lPBw)
    label.delete(lPBm)
    label.delete(lPSw)
    label.delete(lPSm)

    if pendBuyWk
        lPBw := label.new(bar_index + 3, wkVAL, "PEND BUY (Wk)\n" + str.tostring(wkVAL, format.mintick), xloc.bar_index, yloc.price, color.new(#2979FF, 0), label.style_label_up, color.white, size.small)
    if pendBuyMo
        lPBm := label.new(bar_index + 8, moVAL, "PEND BUY (Mo)\n" + str.tostring(moVAL, format.mintick), xloc.bar_index, yloc.price, color.new(#1565C0, 0), label.style_label_up, color.white, size.small)
    if pendSellWk
        lPSw := label.new(bar_index + 3, wkVAH, "PEND SELL (Wk)\n" + str.tostring(wkVAH, format.mintick), xloc.bar_index, yloc.price, color.new(#AA00FF, 0), label.style_label_down, color.white, size.small)
    if pendSellMo
        lPSm := label.new(bar_index + 8, moVAH, "PEND SELL (Mo)\n" + str.tostring(moVAH, format.mintick), xloc.bar_index, yloc.price, color.new(#7B1FA2, 0), label.style_label_down, color.white, size.small)

// ══════════════════════════════════════════════════════════
//  DASHBOARD TABLE
// ══════════════════════════════════════════════════════════

tablePosition = tblPos == "Top Left" ? position.top_left : tblPos == "Bottom Right" ? position.bottom_right : tblPos == "Bottom Left" ? position.bottom_left : position.top_right

var table tbl = showTbl ? table.new(tablePosition, 5, 18, color.new(#0d1117, 5), color.new(#30363d, 0), 1, color.new(#30363d, 0), 1) : na

if showTbl and barstate.islast and not na(tbl)
    hBg = color.new(#161b22, 0)
    hFg = color.white
    dFg = color.new(#e6edf3, 0)
    mFg = color.new(#8b949e, 0)

    // Row 0 — header
    table.cell(tbl, 0, 0, "F98", text_color=hFg, text_size=size.small, bgcolor=hBg, text_halign=text.align_left)
    table.cell(tbl, 1, 0, "V2", text_color=color.new(#FFC107, 0), text_size=size.small, bgcolor=hBg, text_halign=text.align_center)
    table.cell(tbl, 2, 0, stratMode == "AUTO" ? regime : stratMode, text_color=regimeCol, text_size=size.small, bgcolor=hBg, text_halign=text.align_center)
    table.cell(tbl, 3, 0, buyOnly ? "BUY ONLY" : "BUY+SELL", text_color=buyOnly ? color.new(#00E676, 0) : color.new(#FFC107, 0), text_size=size.small, bgcolor=hBg, text_halign=text.align_center)
    table.cell(tbl, 4, 0, "", text_size=size.small, bgcolor=hBg)

    // Row 1 — Regime
    table.cell(tbl, 0, 1, "Regime", text_color=mFg, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 1, regime, text_color=regimeCol, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 1, "Bull:" + str.tostring(bullScore, "#"), text_color=mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 1, "ADX:" + str.tostring(adxV, "#"), text_color=mFg, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 4, 1, "", text_size=size.small)

    // Row 2 — Oscillators
    table.cell(tbl, 0, 2, "Oscillators", text_color=mFg, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 2, oscR, text_color=ratingCol(oscR), text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 2, str.tostring(oscBuy) + "B " + str.tostring(oscNeut) + "N " + str.tostring(oscSell) + "S", text_color=mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 2, "", text_size=size.small)
    table.cell(tbl, 4, 2, "", text_size=size.small)

    // Row 3 — Moving Averages
    table.cell(tbl, 0, 3, "Moving Avg", text_color=mFg, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 3, maR, text_color=ratingCol(maR), text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 3, str.tostring(maBuy) + "B " + str.tostring(maNeut) + "N " + str.tostring(maSell) + "S", text_color=mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 3, "", text_size=size.small)
    table.cell(tbl, 4, 3, "", text_size=size.small)

    // Row 4 — Summary
    table.cell(tbl, 0, 4, "SUMMARY", text_color=hFg, text_size=size.small, bgcolor=hBg, text_halign=text.align_left)
    table.cell(tbl, 1, 4, totR, text_color=ratingCol(totR), text_size=size.small, bgcolor=hBg, text_halign=text.align_center)
    table.cell(tbl, 2, 4, str.tostring(score, "#.##"), text_color=ratingCol(totR), text_size=size.small, bgcolor=hBg, text_halign=text.align_center)
    table.cell(tbl, 3, 4, "", text_size=size.small, bgcolor=hBg)
    table.cell(tbl, 4, 4, "", text_size=size.small, bgcolor=hBg)

    // Row 5 — Quality Score
    float activeQual = buyTrig ? qualBuy : sellTrig ? qualSell : math.max(qualityCalc("BUY", regime, nearestSup), qualityCalc("SELL", regime, nearestRes))
    color qCol = activeQual >= 75 ? color.new(#00E676, 0) : activeQual >= 65 ? color.new(#26A69A, 0) : activeQual >= 50 ? color.new(#FFC107, 0) : color.new(#EF5350, 0)
    table.cell(tbl, 0, 5, "Quality", text_color=mFg, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 5, str.tostring(activeQual, "#") + "/100", text_color=qCol, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 5, "Min:" + str.tostring(minQuality), text_color=mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 5, activeQual >= minQuality ? "PASS" : "FAIL", text_color=activeQual >= minQuality ? color.new(#00E676, 0) : color.new(#FF1744, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 4, 5, "", text_size=size.small)

    // Row 6 — R:R
    float activeRR = buyTrig or nearSup ? rrBuy : sellTrig or nearRes ? rrSell : 0.0
    color rrCol = activeRR >= 2.5 ? color.new(#00E676, 0) : activeRR >= 2.0 ? color.new(#26A69A, 0) : activeRR >= 1.5 ? color.new(#FFC107, 0) : color.new(#EF5350, 0)
    table.cell(tbl, 0, 6, "R:R", text_color=mFg, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 6, str.tostring(activeRR, "#.#") + "R", text_color=rrCol, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 6, "Min:" + str.tostring(rrMin, "#.#"), text_color=mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 6, activeRR >= rrMin ? "PASS" : "FAIL", text_color=activeRR >= rrMin ? color.new(#00E676, 0) : color.new(#FF1744, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 4, 6, "", text_size=size.small)

    // Row 7 — V11 Conditions
    table.cell(tbl, 0, 7, "V11 Check", text_color=color.new(#FFC107, 0), text_size=size.small, bgcolor=hBg, text_halign=text.align_left)
    string v11Status = ""
    if oscOversold
        v11Status += "OS "
    if oscOverbought
        v11Status += "OB "
    if nearSup
        v11Status += "SUP "
    if nearRes
        v11Status += "RES "
    if momBullish
        v11Status += "M+ "
    if momBearish
        v11Status += "M- "
    if v11Status == ""
        v11Status := "---"
    table.cell(tbl, 1, 7, v11Status, text_color=v11_buy or v11_sell ? (v11_buy ? color.new(#00E676, 0) : color.new(#FF1744, 0)) : mFg, text_size=size.small, bgcolor=hBg, text_halign=text.align_center)
    table.cell(tbl, 2, 7, "RSI:" + str.tostring(rsiV, "#") + " K:" + str.tostring(rawK, "#"), text_color=mFg, text_size=size.small, bgcolor=hBg, text_halign=text.align_center)
    table.cell(tbl, 3, 7, "WR:" + str.tostring(wrV, "#"), text_color=mFg, text_size=size.small, bgcolor=hBg, text_halign=text.align_left)
    table.cell(tbl, 4, 7, "", text_size=size.small, bgcolor=hBg)

    // Row 8 — Vetoes
    string vetoText = vetoTransition ? "TRANSITION" : vetoATR ? "ATR" : vetoBuyOnly ? "BUY_ONLY" : vetoBullSell ? "BULL_SELL" : vetoCounterRegime ? "COUNTER_REGIME" : "NONE"
    table.cell(tbl, 0, 8, "Vetoes", text_color=mFg, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 8, vetoText, text_color=vetoed ? color.new(#FF1744, 0) : color.new(#00E676, 0), text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 8, "", text_size=size.small)
    table.cell(tbl, 3, 8, "", text_size=size.small)
    table.cell(tbl, 4, 8, "", text_size=size.small)

    // Row 9 — spacer
    for c = 0 to 4
        table.cell(tbl, c, 9, "", text_size=size.tiny)

    // Rows 10-12 — Weekly VP
    table.cell(tbl, 0, 10, "Wk VAH", text_color=color.new(#EF5350, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 10, not na(wkVAH) ? str.tostring(wkVAH, format.mintick) : "—", text_color=dFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 10, str.tostring(distWkVAH, "#.#") + " ATR", text_color=nearWkVAH ? color.new(#FF9800, 0) : mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 10, nearWkVAH ? "NEAR" : "", text_color=color.new(#FF9800, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 4, 10, "", text_size=size.small)

    table.cell(tbl, 0, 11, "Wk POC", text_color=color.new(#FF9800, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 11, not na(wkPOC) ? str.tostring(wkPOC, format.mintick) : "—", text_color=dFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 11, str.tostring(distWkPOC, "#.#") + " ATR", text_color=nearWkPOC ? color.new(#FF9800, 0) : mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 11, "", text_size=size.small)
    table.cell(tbl, 4, 11, "", text_size=size.small)

    table.cell(tbl, 0, 12, "Wk VAL", text_color=color.new(#26A69A, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 12, not na(wkVAL) ? str.tostring(wkVAL, format.mintick) : "—", text_color=dFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 12, str.tostring(distWkVAL, "#.#") + " ATR", text_color=nearWkVAL ? color.new(#FF9800, 0) : mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 12, nearWkVAL ? "NEAR" : "", text_color=color.new(#FF9800, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 4, 12, "", text_size=size.small)

    // Rows 13-15 — Monthly VP
    table.cell(tbl, 0, 13, "Mo VAH", text_color=color.new(#EF5350, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 13, not na(moVAH) ? str.tostring(moVAH, format.mintick) : "—", text_color=dFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 13, str.tostring(distMoVAH, "#.#") + " ATR", text_color=nearMoVAH ? color.new(#FF9800, 0) : mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 13, nearMoVAH ? "NEAR" : "", text_color=color.new(#FF9800, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 4, 13, "", text_size=size.small)

    table.cell(tbl, 0, 14, "Mo POC", text_color=color.new(#FF9800, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 14, not na(moPOC) ? str.tostring(moPOC, format.mintick) : "—", text_color=dFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 14, str.tostring(distMoPOC, "#.#") + " ATR", text_color=nearMoPOC ? color.new(#FF9800, 0) : mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 14, "", text_size=size.small)
    table.cell(tbl, 4, 14, "", text_size=size.small)

    table.cell(tbl, 0, 15, "Mo VAL", text_color=color.new(#26A69A, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 15, not na(moVAL) ? str.tostring(moVAL, format.mintick) : "—", text_color=dFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 15, str.tostring(distMoVAL, "#.#") + " ATR", text_color=nearMoVAL ? color.new(#FF9800, 0) : mFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 15, nearMoVAL ? "NEAR" : "", text_color=color.new(#FF9800, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 4, 15, "", text_size=size.small)

    // Row 16 — spacer
    for c = 0 to 4
        table.cell(tbl, c, 16, "", text_size=size.tiny)

    // Row 17 — Signal + Stop/Target
    table.cell(tbl, 0, 17, "SIGNAL", text_color=hFg, text_size=size.small, bgcolor=hBg, text_halign=text.align_left)
    table.cell(tbl, 1, 17, sigText, text_color=sigCol, text_size=size.small, bgcolor=hBg, text_halign=text.align_center)
    string sltp = not na(activeSL) ? "SL:" + str.tostring(activeSL, format.mintick) + " TP:" + str.tostring(activeTP, format.mintick) : "---"
    table.cell(tbl, 2, 17, sltp, text_color=not na(activeSL) ? color.new(#FFC107, 0) : mFg, text_size=size.small, bgcolor=hBg, text_halign=text.align_center)
    table.cell(tbl, 3, 17, "", text_size=size.small, bgcolor=hBg)
    table.cell(tbl, 4, 17, "", text_size=size.small, bgcolor=hBg)

// ══════════════════════════════════════════════════════════
//  ALERTS
// ══════════════════════════════════════════════════════════

alertcondition(buyTrig,  "Market Buy",  "F98 V2 BUY at {{close}} — Quality passed | R:R passed")
alertcondition(sellTrig, "Market Sell", "F98 V2 SELL at {{close}} — Quality passed | R:R passed")
alertcondition(pendBuyWk  and not (pendBuyWk[1]  == true),  "Pending Buy (Wk)",  "Pending BUY zone — Weekly VAL {{close}}")
alertcondition(pendSellWk and not (pendSellWk[1] == true), "Pending Sell (Wk)", "Pending SELL zone — Weekly VAH {{close}}")
alertcondition(pendBuyMo  and not (pendBuyMo[1]  == true),  "Pending Buy (Mo)",  "Pending BUY zone — Monthly VAL {{close}}")
alertcondition(pendSellMo and not (pendSellMo[1] == true), "Pending Sell (Mo)", "Pending SELL zone — Monthly VAH {{close}}")
alertcondition(regime == "TRANSITION" and (na(regime[1]) or regime[1] != "TRANSITION"), "Regime Transition", "VETO: Market entered TRANSITION regime — no new entries")
alertcondition(not na(activeSL) and ((activeIsBuy and low <= activeSL) or (not activeIsBuy and high >= activeSL)), "Stop Hit", "Stop loss hit — exit position")
