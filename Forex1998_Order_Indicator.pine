//@version=5
indicator("Forex1998 Trading Order Indicator", "F98 Orders", true, max_bars_back=5000, max_labels_count=200, max_lines_count=100)

// ══════════════════════════════════════════════════════════
//  INPUTS
// ══════════════════════════════════════════════════════════

// ── Volume Profile ──
g1      = "Volume Profile"
vpRows  = input.int(100, "Rows", minval=10, maxval=200, group=g1)
vpVA    = input.float(69, "Value Area %", minval=50, maxval=95, step=1, group=g1)
showWk  = input.bool(true, "Show Weekly Levels", group=g1)
showMo  = input.bool(true, "Show Monthly Levels", group=g1)

// ── Signals (V11 Hybrid — backtested parameters) ──
g2      = "Signal Settings"
proxPct = input.float(0.2, "VP Level Proximity %", minval=0.05, maxval=2.0, step=0.05, group=g2, tooltip="Price must be within this % of a VP level to trigger. Backtested optimum: 0.2%")
rsiOB   = input.int(65, "RSI Overbought", minval=55, maxval=80, group=g2, tooltip="RSI threshold for sell signals (backtested: 65)")
rsiOS   = input.int(35, "RSI Oversold", minval=20, maxval=45, group=g2, tooltip="RSI threshold for buy signals (backtested: 35)")
cdBars  = input.int(5, "Signal Cooldown (bars)", minval=1, maxval=50, group=g2, tooltip="Min bars between consecutive same-direction signals.")
holdBars = input.int(15, "Suggested Hold (bars)", minval=5, maxval=50, group=g2, tooltip="Suggested exit bars after entry. Backtested optimum: 15-20 bars on 4H.")

// ── Display ──
g3      = "Display"
showTbl = input.bool(true, "Show Score Dashboard", group=g3)
tblPos  = input.string("Top Right", "Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=g3)
showBg  = input.bool(true, "Trend Background Tint", group=g3)
showPnd = input.bool(true, "Pending-Order Labels", group=g3)

// ══════════════════════════════════════════════════════════
//  VOLUME PROFILE — core calculation
// ══════════════════════════════════════════════════════════

vpCalc(float[] bins, float hi, float lo, float totV, int rows, float vaPct) =>
    float _poc = na
    float _vah = na
    float _val = na
    if hi > lo and totV > 0
        float bs = (hi - lo) / rows
        float mx = 0.0
        int   pi = 0
        for i = 0 to rows - 1
            float v = array.get(bins, i)
            if v > mx
                mx := v
                pi := i
        _poc := lo + (pi + 0.5) * bs
        float av = mx
        int   aH = pi
        int   aL = pi
        float tgt = totV * vaPct / 100.0
        for _j = 0 to rows
            if av >= tgt
                break
            float uv = aH < rows - 1 ? array.get(bins, aH + 1) : 0.0
            float dv = aL > 0       ? array.get(bins, aL - 1) : 0.0
            if (uv >= dv or aL <= 0) and aH < rows - 1
                aH += 1
                av += uv
            else if aL > 0
                aL -= 1
                av += dv
            else
                break
        _vah := lo + (aH + 1) * bs
        _val := lo + aL * bs
    [_poc, _vah, _val]

// ── Weekly VP ──
var float[] wkBins = array.new_float(vpRows, 0.0)
var float   wkHi   = na
var float   wkLo   = na
var float   wkVol  = 0.0

if ta.change(time("W"))
    array.fill(wkBins, 0.0)
    wkHi  := high
    wkLo  := low
    wkVol := 0.0
if na(wkHi)
    wkHi := high
    wkLo := low

wkHi := math.max(wkHi, high)
wkLo := math.min(wkLo, low)

if wkHi > wkLo
    float bs = (wkHi - wkLo) / vpRows
    int   ix = math.min(int(math.floor((hlc3 - wkLo) / bs)), vpRows - 1)
    if ix >= 0 and ix < vpRows
        array.set(wkBins, ix, array.get(wkBins, ix) + volume)
    wkVol += volume

[wkPOC, wkVAH, wkVAL] = vpCalc(wkBins, wkHi, wkLo, wkVol, vpRows, vpVA)

// ── Monthly VP ──
var float[] moBins = array.new_float(vpRows, 0.0)
var float   moHi   = na
var float   moLo   = na
var float   moVol  = 0.0

if ta.change(time("M"))
    array.fill(moBins, 0.0)
    moHi  := high
    moLo  := low
    moVol := 0.0
if na(moHi)
    moHi := high
    moLo := low

moHi := math.max(moHi, high)
moLo := math.min(moLo, low)

if moHi > moLo
    float bs = (moHi - moLo) / vpRows
    int   ix = math.min(int(math.floor((hlc3 - moLo) / bs)), vpRows - 1)
    if ix >= 0 and ix < vpRows
        array.set(moBins, ix, array.get(moBins, ix) + volume)
    moVol += volume

[moPOC, moVAH, moVAL] = vpCalc(moBins, moHi, moLo, moVol, vpRows, vpVA)

// ══════════════════════════════════════════════════════════
//  OSCILLATORS  (11 — matches TradingView Technicals)
//  Each returns  1 = Buy,  0 = Neutral,  -1 = Sell
// ══════════════════════════════════════════════════════════

// 1  RSI (14)
float rsiV = ta.rsi(close, 14)
int   sRsi = rsiV < 30 ? 1 : rsiV > 70 ? -1 : 0

// 2  Stochastic %K (14, 3, 3)
float rawK  = ta.sma(ta.stoch(close, high, low, 14), 3)
float rawD  = ta.sma(rawK, 3)
int   sStch = rawK < 20 ? 1 : rawK > 80 ? -1 : 0

// 3  CCI (20)
float cciV = ta.cci(close, 20)
int   sCci = cciV < -100 ? 1 : cciV > 100 ? -1 : 0

// 4  ADX (14) — direction from DI+/DI-
[dip, dim, adxV] = ta.dmi(14, 14)
int sAdx = adxV > 20 and dip > dim ? 1 : adxV > 20 and dim > dip ? -1 : 0

// 5  Awesome Oscillator
float aoV = ta.sma(hl2, 5) - ta.sma(hl2, 34)
int   sAo = aoV > 0 ? 1 : aoV < 0 ? -1 : 0

// 6  Momentum (10)
float momV = ta.mom(close, 10)
int   sMom = momV > 0 ? 1 : momV < 0 ? -1 : 0

// 7  MACD (12, 26, 9)
[macdL, sigL, _hist] = ta.macd(close, 12, 26, 9)
int sMacd = macdL > sigL ? 1 : macdL < sigL ? -1 : 0

// 8  Stochastic RSI Fast (3, 3, 14, 14)
float srRaw = ta.sma(ta.stoch(ta.rsi(close, 14), ta.rsi(close, 14), ta.rsi(close, 14), 14), 3)
float srD   = ta.sma(srRaw, 3)
int   sSrsi = srRaw < 20 ? 1 : srRaw > 80 ? -1 : 0

// 9  Williams %R (14)
float wrV = ta.wpr(14)
int   sWr = wrV < -80 ? 1 : wrV > -20 ? -1 : 0

// 10  Bull Bear Power
float bbpV = (high - ta.ema(close, 13)) + (low - ta.ema(close, 13))
int   sBbp = bbpV > 0 ? 1 : bbpV < 0 ? -1 : 0

// 11  Ultimate Oscillator (7, 14, 28)
float bp  = close - math.min(low, nz(close[1], low))
float tr  = math.max(high, nz(close[1], high)) - math.min(low, nz(close[1], low))
float uoV = 100.0 * (4.0 * math.sum(bp, 7) / math.sum(tr, 7) + 2.0 * math.sum(bp, 14) / math.sum(tr, 14) + math.sum(bp, 28) / math.sum(tr, 28)) / 7.0
int   sUo = uoV < 30 ? 1 : uoV > 70 ? -1 : 0

// Aggregate oscillator score
int oscBuy  = (sRsi==1?1:0)+(sStch==1?1:0)+(sCci==1?1:0)+(sAdx==1?1:0)+(sAo==1?1:0)+(sMom==1?1:0)+(sMacd==1?1:0)+(sSrsi==1?1:0)+(sWr==1?1:0)+(sBbp==1?1:0)+(sUo==1?1:0)
int oscSell = (sRsi==-1?1:0)+(sStch==-1?1:0)+(sCci==-1?1:0)+(sAdx==-1?1:0)+(sAo==-1?1:0)+(sMom==-1?1:0)+(sMacd==-1?1:0)+(sSrsi==-1?1:0)+(sWr==-1?1:0)+(sBbp==-1?1:0)+(sUo==-1?1:0)
int oscNeut = 11 - oscBuy - oscSell
float oscScore = (oscBuy - oscSell) / 11.0

// ══════════════════════════════════════════════════════════
//  MOVING AVERAGES  (15 — matches TradingView Technicals)
//  Buy when close > MA,  Sell when close < MA
// ══════════════════════════════════════════════════════════

float e10  = ta.ema(close, 10)
float s10  = ta.sma(close, 10)
float e20  = ta.ema(close, 20)
float s20  = ta.sma(close, 20)
float e30  = ta.ema(close, 30)
float s30  = ta.sma(close, 30)
float e50  = ta.ema(close, 50)
float s50  = ta.sma(close, 50)
float e100 = ta.ema(close, 100)
float s100 = ta.sma(close, 100)
float e200 = ta.ema(close, 200)
float s200 = ta.sma(close, 200)
float ich  = (ta.highest(high, 26) + ta.lowest(low, 26)) / 2.0
float vw20 = ta.vwma(close, 20)
float hma9 = ta.wma(2.0 * ta.wma(close, int(math.round(9.0 / 2.0))) - ta.wma(close, 9), int(math.round(math.sqrt(9.0))))

int maBuy  = 0
int maSell = 0
maBuy  += close > e10  ? 1 : 0
maSell += close < e10  ? 1 : 0
maBuy  += close > s10  ? 1 : 0
maSell += close < s10  ? 1 : 0
maBuy  += close > e20  ? 1 : 0
maSell += close < e20  ? 1 : 0
maBuy  += close > s20  ? 1 : 0
maSell += close < s20  ? 1 : 0
maBuy  += close > e30  ? 1 : 0
maSell += close < e30  ? 1 : 0
maBuy  += close > s30  ? 1 : 0
maSell += close < s30  ? 1 : 0
maBuy  += close > e50  ? 1 : 0
maSell += close < e50  ? 1 : 0
maBuy  += close > s50  ? 1 : 0
maSell += close < s50  ? 1 : 0
maBuy  += close > e100 ? 1 : 0
maSell += close < e100 ? 1 : 0
maBuy  += close > s100 ? 1 : 0
maSell += close < s100 ? 1 : 0
maBuy  += close > e200 ? 1 : 0
maSell += close < e200 ? 1 : 0
maBuy  += close > s200 ? 1 : 0
maSell += close < s200 ? 1 : 0
maBuy  += close > ich  ? 1 : 0
maSell += close < ich  ? 1 : 0
maBuy  += close > vw20 ? 1 : 0
maSell += close < vw20 ? 1 : 0
maBuy  += close > hma9 ? 1 : 0
maSell += close < hma9 ? 1 : 0

int   maNeut  = 15 - maBuy - maSell
float maScore = (maBuy - maSell) / 15.0

// ══════════════════════════════════════════════════════════
//  COMPOSITE SCORE  &  RATINGS
// ══════════════════════════════════════════════════════════

float score = (oscScore + maScore) / 2.0

rating(float s) =>
    s > 0.5 ? "STRONG BUY" : s > 0.1 ? "BUY" : s < -0.5 ? "STRONG SELL" : s < -0.1 ? "SELL" : "NEUTRAL"

ratingCol(string r) =>
    switch r
        "STRONG BUY"  => color.new(#00E676, 0)
        "BUY"         => color.new(#26A69A, 0)
        "SELL"        => color.new(#EF5350, 0)
        "STRONG SELL" => color.new(#FF1744, 0)
        => color.new(#78909C, 0)

string oscR = rating(oscScore)
string maR  = rating(maScore)
string totR = rating(score)

// ══════════════════════════════════════════════════════════
//  V11 HYBRID SIGNAL GENERATION
//  Backtested: 91% win rate, +612.5 pips, PF 7.26 on EUR/USD 4H
//
//  Entry requires ALL THREE conditions:
//    1. Oscillator extreme  (RSI/Stoch/WR hit threshold)
//    2. Near VP level       (within proximity % of VAL or VAH)
//    3. Momentum confirm    (composite score improving bar-over-bar)
// ══════════════════════════════════════════════════════════

float prox = close * proxPct / 100.0

// ── Condition 1: Oscillator extremes ──
bool oscOversold  = rsiV < rsiOS or rawK < 25 or wrV < -75
bool oscOverbought = rsiV > rsiOB or rawK > 75 or wrV > -25

// ── Condition 2: Near VP levels ──
bool nearWkVAL = not na(wkVAL) and math.abs(close - wkVAL) <= prox
bool nearWkVAH = not na(wkVAH) and math.abs(close - wkVAH) <= prox
bool nearMoVAL = not na(moVAL) and math.abs(close - moVAL) <= prox
bool nearMoVAH = not na(moVAH) and math.abs(close - moVAH) <= prox
bool nearSup = nearWkVAL or nearMoVAL
bool nearRes = nearWkVAH or nearMoVAH

// ── Condition 3: Momentum confirmation ──
float prevScore = nz(score[1], 0)
bool momBullish = score > prevScore
bool momBearish = score < prevScore

// ── Market orders: all 3 conditions must align ──
bool mktBuy  = oscOversold  and nearSup and momBullish
bool mktSell = oscOverbought and nearRes and momBearish

// Cooldown
var int lastBuyBar  = -9999
var int lastSellBar = -9999
bool buyTrig  = mktBuy  and (bar_index - lastBuyBar  >= cdBars)
bool sellTrig = mktSell and (bar_index - lastSellBar >= cdBars)
if buyTrig
    lastBuyBar := bar_index
if sellTrig
    lastSellBar := bar_index

// ── Suggested exit bar tracking ──
var int buyExitBar  = na
var int sellExitBar = na
if buyTrig
    buyExitBar := bar_index + holdBars
if sellTrig
    sellExitBar := bar_index + holdBars

bool buyExitNow  = not na(buyExitBar) and bar_index == buyExitBar
bool sellExitNow = not na(sellExitBar) and bar_index == sellExitBar

if buyExitNow
    buyExitBar := na
if sellExitNow
    sellExitBar := na

// ── Pending orders: VP levels the price hasn't reached yet ──
//    Oscillators approaching extremes increase pending order confidence
bool oscApproachOS = rsiV < 45 or rawK < 35 or wrV < -55
bool oscApproachOB = rsiV > 55 or rawK > 65 or wrV > -45

bool pendBuyWk  = not na(wkVAL) and close > wkVAL + prox and oscApproachOS and momBullish
bool pendBuyMo  = not na(moVAL) and close > moVAL + prox and oscApproachOS and momBullish
bool pendSellWk = not na(wkVAH) and close < wkVAH - prox and oscApproachOB and momBearish
bool pendSellMo = not na(moVAH) and close < moVAH - prox and oscApproachOB and momBearish

// ── Signal strength (how many oscillator extremes are active) ──
int oscExtBuy  = (rsiV < rsiOS ? 1 : 0) + (rawK < 25 ? 1 : 0) + (wrV < -75 ? 1 : 0)
int oscExtSell = (rsiV > rsiOB ? 1 : 0) + (rawK > 75 ? 1 : 0) + (wrV > -25 ? 1 : 0)
string strength = oscExtBuy >= 2 or oscExtSell >= 2 ? "STRONG" : "NORMAL"

// Primary signal for the dashboard
string sigText = "WAIT"
color  sigCol  = color.gray
if mktBuy
    sigText := "MKT BUY (" + strength + ")"
    sigCol  := color.new(#00E676, 0)
else if mktSell
    sigText := "MKT SELL (" + strength + ")"
    sigCol  := color.new(#FF1744, 0)
else if pendBuyMo
    sigText := "PEND BUY @ " + str.tostring(moVAL, format.mintick)
    sigCol  := color.new(#2979FF, 0)
else if pendBuyWk
    sigText := "PEND BUY @ " + str.tostring(wkVAL, format.mintick)
    sigCol  := color.new(#2979FF, 0)
else if pendSellMo
    sigText := "PEND SELL @ " + str.tostring(moVAH, format.mintick)
    sigCol  := color.new(#AA00FF, 0)
else if pendSellWk
    sigText := "PEND SELL @ " + str.tostring(wkVAH, format.mintick)
    sigCol  := color.new(#AA00FF, 0)

// ══════════════════════════════════════════════════════════
//  PLOTS
// ══════════════════════════════════════════════════════════

// VP levels — weekly (thin, semi-transparent) & monthly (thick, solid)
plot(showWk ? wkPOC : na, "Wk POC", color.new(#FF9800, 30), 1, plot.style_stepline)
plot(showWk ? wkVAH : na, "Wk VAH", color.new(#EF5350, 30), 1, plot.style_stepline)
plot(showWk ? wkVAL : na, "Wk VAL", color.new(#26A69A, 30), 1, plot.style_stepline)

plot(showMo ? moPOC : na, "Mo POC", color.new(#FF9800, 0), 2, plot.style_stepline)
plot(showMo ? moVAH : na, "Mo VAH", color.new(#EF5350, 0), 2, plot.style_stepline)
plot(showMo ? moVAL : na, "Mo VAL", color.new(#26A69A, 0), 2, plot.style_stepline)

// Market-order signals
plotshape(buyTrig,  "Market Buy",  shape.labelup,   location.belowbar, color.new(#00E676, 0), text="MKT\nBUY",  textcolor=color.white, size=size.normal)
plotshape(sellTrig, "Market Sell", shape.labeldown,  location.abovebar, color.new(#FF1744, 0), text="MKT\nSELL", textcolor=color.white, size=size.normal)

// Suggested exit markers
plotshape(buyExitNow,  "Buy Exit",  shape.xcross, location.abovebar, color.new(#00E676, 50), text="EXIT", textcolor=color.new(#00E676, 50), size=size.tiny)
plotshape(sellExitNow, "Sell Exit", shape.xcross, location.belowbar, color.new(#FF1744, 50), text="EXIT", textcolor=color.new(#FF1744, 50), size=size.tiny)

// Trend background tint
bgcolor(showBg and score > 0.5 ? color.new(#00E676, 92) : showBg and score < -0.5 ? color.new(#FF1744, 92) : na, title="Trend Tint")

// ── Pending-order labels on the last bar ──
var label lPBw = na
var label lPBm = na
var label lPSw = na
var label lPSm = na

if barstate.islast and showPnd
    label.delete(lPBw)
    label.delete(lPBm)
    label.delete(lPSw)
    label.delete(lPSm)

    if pendBuyWk
        lPBw := label.new(bar_index + 3, wkVAL, "PEND BUY (Wk)\n" + str.tostring(wkVAL, format.mintick), xloc.bar_index, yloc.price, color.new(#2979FF, 0), label.style_label_up, color.white, size.small)
    if pendBuyMo
        lPBm := label.new(bar_index + 8, moVAL, "PEND BUY (Mo)\n" + str.tostring(moVAL, format.mintick), xloc.bar_index, yloc.price, color.new(#1565C0, 0), label.style_label_up, color.white, size.small)
    if pendSellWk
        lPSw := label.new(bar_index + 3, wkVAH, "PEND SELL (Wk)\n" + str.tostring(wkVAH, format.mintick), xloc.bar_index, yloc.price, color.new(#AA00FF, 0), label.style_label_down, color.white, size.small)
    if pendSellMo
        lPSm := label.new(bar_index + 8, moVAH, "PEND SELL (Mo)\n" + str.tostring(moVAH, format.mintick), xloc.bar_index, yloc.price, color.new(#7B1FA2, 0), label.style_label_down, color.white, size.small)

// ══════════════════════════════════════════════════════════
//  DASHBOARD TABLE
// ══════════════════════════════════════════════════════════

tablePosition = tblPos == "Top Left" ? position.top_left : tblPos == "Bottom Right" ? position.bottom_right : tblPos == "Bottom Left" ? position.bottom_left : position.top_right

var table tbl = showTbl ? table.new(tablePosition, 4, 15, color.new(#0d1117, 5), color.new(#30363d, 0), 1, color.new(#30363d, 0), 1) : na

if showTbl and barstate.islast and not na(tbl)
    hBg = color.new(#161b22, 0)
    hFg = color.white
    dFg = color.new(#e6edf3, 0)
    mFg = color.new(#8b949e, 0)

    // Row 0 — header
    table.cell(tbl, 0, 0, "F98 V11", text_color=hFg, text_size=size.small, bgcolor=hBg, text_halign=text.align_left)
    table.cell(tbl, 1, 0, "ORDER", text_color=hFg, text_size=size.small, bgcolor=hBg, text_halign=text.align_center)
    table.cell(tbl, 2, 0, "INDICATOR", text_color=hFg, text_size=size.small, bgcolor=hBg, text_halign=text.align_center)
    table.cell(tbl, 3, 0, "", text_color=hFg, text_size=size.small, bgcolor=hBg)

    // Row 1 — Oscillators
    table.cell(tbl, 0, 1, "Oscillators", text_color=mFg, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 1, oscR, text_color=ratingCol(oscR), text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 1, str.tostring(oscBuy) + "B", text_color=color.new(#26A69A, 0), text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 1, str.tostring(oscNeut) + "N " + str.tostring(oscSell) + "S", text_color=mFg, text_size=size.small, text_halign=text.align_left)

    // Row 2 — Moving Averages
    table.cell(tbl, 0, 2, "Moving Avg", text_color=mFg, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 2, maR, text_color=ratingCol(maR), text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 2, str.tostring(maBuy) + "B", text_color=color.new(#26A69A, 0), text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 2, str.tostring(maNeut) + "N " + str.tostring(maSell) + "S", text_color=mFg, text_size=size.small, text_halign=text.align_left)

    // Row 3 — Summary
    table.cell(tbl, 0, 3, "SUMMARY", text_color=hFg, text_size=size.small, bgcolor=hBg, text_halign=text.align_left)
    table.cell(tbl, 1, 3, totR, text_color=ratingCol(totR), text_size=size.small, bgcolor=hBg, text_halign=text.align_center)
    table.cell(tbl, 2, 3, str.tostring(score, "#.##"), text_color=ratingCol(totR), text_size=size.small, bgcolor=hBg, text_halign=text.align_center)
    table.cell(tbl, 3, 3, "", text_size=size.small, bgcolor=hBg)

    // Row 4 — V11 Entry Conditions
    table.cell(tbl, 0, 4, "V11 Check", text_color=color.new(#FFC107, 0), text_size=size.small, bgcolor=hBg, text_halign=text.align_left)
    string v11Status = ""
    color v11Col = mFg
    if oscOversold
        v11Status += "OS "
    if oscOverbought
        v11Status += "OB "
    if nearSup
        v11Status += "SUP "
    if nearRes
        v11Status += "RES "
    if momBullish
        v11Status += "M+ "
    if momBearish
        v11Status += "M- "
    if v11Status == ""
        v11Status := "---"
    if mktBuy or mktSell
        v11Col := mktBuy ? color.new(#00E676, 0) : color.new(#FF1744, 0)
    table.cell(tbl, 1, 4, v11Status, text_color=v11Col, text_size=size.small, bgcolor=hBg, text_halign=text.align_center)
    table.cell(tbl, 2, 4, "RSI:" + str.tostring(rsiV, "#") + " K:" + str.tostring(rawK, "#"), text_color=mFg, text_size=size.small, bgcolor=hBg, text_halign=text.align_center)
    table.cell(tbl, 3, 4, "WR:" + str.tostring(wrV, "#"), text_color=mFg, text_size=size.small, bgcolor=hBg, text_halign=text.align_left)

    // Row 5 — spacer
    for c = 0 to 3
        table.cell(tbl, c, 5, "", text_size=size.tiny)

    // Rows 6-8 — Weekly VP
    table.cell(tbl, 0, 6, "Wk VAH", text_color=color.new(#EF5350, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 6, not na(wkVAH) ? str.tostring(wkVAH, format.mintick) : "—", text_color=dFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 6, pendSellWk ? "PEND SELL" : nearWkVAH ? "AT LEVEL" : "", text_color=pendSellWk ? color.new(#AA00FF, 0) : color.new(#FF9800, 0), text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 6, "", text_size=size.small)

    table.cell(tbl, 0, 7, "Wk POC", text_color=color.new(#FF9800, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 7, not na(wkPOC) ? str.tostring(wkPOC, format.mintick) : "—", text_color=dFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 7, "", text_size=size.small)
    table.cell(tbl, 3, 7, "", text_size=size.small)

    table.cell(tbl, 0, 8, "Wk VAL", text_color=color.new(#26A69A, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 8, not na(wkVAL) ? str.tostring(wkVAL, format.mintick) : "—", text_color=dFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 8, pendBuyWk ? "PEND BUY" : nearWkVAL ? "AT LEVEL" : "", text_color=pendBuyWk ? color.new(#2979FF, 0) : color.new(#FF9800, 0), text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 8, "", text_size=size.small)

    // Rows 9-11 — Monthly VP
    table.cell(tbl, 0, 9, "Mo VAH", text_color=color.new(#EF5350, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 9, not na(moVAH) ? str.tostring(moVAH, format.mintick) : "—", text_color=dFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 9, pendSellMo ? "PEND SELL" : nearMoVAH ? "AT LEVEL" : "", text_color=pendSellMo ? color.new(#AA00FF, 0) : color.new(#FF9800, 0), text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 9, "", text_size=size.small)

    table.cell(tbl, 0, 10, "Mo POC", text_color=color.new(#FF9800, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 10, not na(moPOC) ? str.tostring(moPOC, format.mintick) : "—", text_color=dFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 10, "", text_size=size.small)
    table.cell(tbl, 3, 10, "", text_size=size.small)

    table.cell(tbl, 0, 11, "Mo VAL", text_color=color.new(#26A69A, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 11, not na(moVAL) ? str.tostring(moVAL, format.mintick) : "—", text_color=dFg, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 11, pendBuyMo ? "PEND BUY" : nearMoVAL ? "AT LEVEL" : "", text_color=pendBuyMo ? color.new(#2979FF, 0) : color.new(#FF9800, 0), text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 11, "", text_size=size.small)

    // Row 12 — spacer
    for c = 0 to 3
        table.cell(tbl, c, 12, "", text_size=size.tiny)

    // Row 13 — active signal
    table.cell(tbl, 0, 13, "SIGNAL", text_color=hFg, text_size=size.small, bgcolor=hBg, text_halign=text.align_left)
    table.cell(tbl, 1, 13, sigText, text_color=sigCol, text_size=size.small, bgcolor=hBg, text_halign=text.align_center)
    table.cell(tbl, 2, 13, "", text_size=size.small, bgcolor=hBg)
    table.cell(tbl, 3, 13, "", text_size=size.small, bgcolor=hBg)

    // Row 14 — hold info
    string holdInfo = ""
    if not na(buyExitBar) and buyExitBar > bar_index
        holdInfo := "BUY exit in " + str.tostring(buyExitBar - bar_index) + " bars"
    if not na(sellExitBar) and sellExitBar > bar_index
        holdInfo := "SELL exit in " + str.tostring(sellExitBar - bar_index) + " bars"
    table.cell(tbl, 0, 14, "HOLD", text_color=mFg, text_size=size.small, bgcolor=hBg, text_halign=text.align_left)
    table.cell(tbl, 1, 14, holdInfo != "" ? holdInfo : "---", text_color=holdInfo != "" ? color.new(#FFC107, 0) : mFg, text_size=size.small, bgcolor=hBg, text_halign=text.align_center)
    table.cell(tbl, 2, 14, "", text_size=size.small, bgcolor=hBg)
    table.cell(tbl, 3, 14, "", text_size=size.small, bgcolor=hBg)

// ══════════════════════════════════════════════════════════
//  ALERTS
// ══════════════════════════════════════════════════════════

alertcondition(buyTrig,  "Market Buy",  "V11 MARKET BUY at {{close}} — Osc extreme + VP support + momentum confirm")
alertcondition(sellTrig, "Market Sell", "V11 MARKET SELL at {{close}} — Osc extreme + VP resistance + momentum confirm")
alertcondition(pendBuyWk  and not nz(pendBuyWk[1]),  "Pending Buy (Wk)",  "Pending BUY zone — Weekly VAL {{close}}")
alertcondition(pendSellWk and not nz(pendSellWk[1]), "Pending Sell (Wk)", "Pending SELL zone — Weekly VAH {{close}}")
alertcondition(pendBuyMo  and not nz(pendBuyMo[1]),  "Pending Buy (Mo)",  "Pending BUY zone — Monthly VAL {{close}}")
alertcondition(pendSellMo and not nz(pendSellMo[1]), "Pending Sell (Mo)", "Pending SELL zone — Monthly VAH {{close}}")
alertcondition(buyExitNow,  "Buy Exit Suggestion",  "Suggested BUY exit — hold period complete")
alertcondition(sellExitNow, "Sell Exit Suggestion", "Suggested SELL exit — hold period complete")
